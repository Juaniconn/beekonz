---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Seguimiento de Pedidos | Beekonz" description="Consulta el estado de tu pedido en tiempo real, desde fabricación hasta entrega.">
  <Header />
  <main class="mx-auto max-w-4xl px-4 pt-32 pb-24 sm:px-6">
    <p class="text-center text-xs font-semibold tracking-widest text-bee-400 uppercase">Transparencia Total</p>
    <h1 class="font-display mt-3 text-center text-3xl font-bold sm:text-5xl">Seguimiento de <span class="text-gradient-bee">Pedidos</span></h1>
    <p class="mx-auto mt-4 max-w-xl text-center text-neutral-400">
      Consulta el estado de tu pedido en tiempo real, desde fabricación hasta entrega. En Beekonz creemos en la transparencia total: aquí visualizas el estado real de tu pedido directamente desde nuestro sistema interno de seguimiento.
    </p>

    <div class="mt-12 overflow-hidden rounded-2xl border border-white/10 bg-hive-900/50" style="min-height: 600px;">
      <!-- Embed de ClickUp -->
      <iframe
        src="https://app.clickup.com/embed?v=8cr2nra-517"
        width="100%"
        height="700"
        style="border: none;"
        loading="lazy"
        title="Sistema de seguimiento Beekonz"
      >
      </iframe>
    </div>

    <div class="mt-8 rounded-xl border border-white/8 bg-hive-900/50 p-6 text-center">
      <p class="text-sm text-neutral-300">
        Si tu pedido no aparece, contáctanos directamente para ayudarte.
      </p>
      <a
        href="https://discord.gg/ekr3ERWJQ6"
        target="_blank"
        rel="noopener"
        class="mt-4 inline-block rounded-full border border-bee-400/40 px-6 py-2.5 font-display font-semibold text-bee-400 transition hover:bg-bee-400 hover:text-hive-950"
      >
        ¿Tienes dudas sobre tu pedido?
      </a>
    </div>
  </main>
  <Footer />
</Base>
