---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Seguimiento de Pedidos | Beekonz Trackers">
  <Header />
  <section class="pt-40 pb-20 bg-[#050505]">
    <div class="container max-w-3xl text-center">
      <p class="caption text-[#EAD08E] tracking-widest uppercase mb-4">Seguimiento</p>
      <h1 class="display-lg text-white mb-6">Estado de tu Pedido</h1>
      <p class="body-lg text-[#a0a0a0]">Consulta el estado de tu envío con el número de orden de tu compra.</p>
    </div>
  </section>
  <section class="section bg-white">
    <div class="container max-w-4xl">
      <div class="rounded-xl overflow-hidden border border-[#050505]/10">
        <iframe src="https://app.clickup.com/embed?v=8cr2nra-517" class="w-full h-[600px] border-0"></iframe>
      </div>
      <div class="mt-8 text-center">
        <p class="body-md text-[#555555] mb-4">¿No encuentras tu pedido? Contáctanos en Discord.</p>
        <a href="https://discord.gg/ekr3ERWJQ6" target="_blank" rel="noopener noreferrer" class="btn btn-gold px-6 py-3">
          Contactar por Discord
        </a>
      </div>
    </div>
  </section>
  <Footer />
</Base>
