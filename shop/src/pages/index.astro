---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  SITE,
  STATS,
  PACKS,
  FACE_TRACKING,
  FEATURES,
  GALLERY,
  TESTIMONIALS,
  TRAYECTORIA,
  FAQ,
} from "../data/store";
---

<Base>
  <Header />

  <main>
    <!-- ═══════════ HERO - ESTYLE FANTOM UI ═══════════ -->
    <section class="relative min-h-screen overflow-hidden flex items-center justify-center pt-32 pb-20 bg-[#0a0a0f]">
      <!-- Background degradado -->
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0f] via-[#0f0f1a] to-[#0a0a0f]"></div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-[radial-gradient(ellipse_at_center,_rgba(0,255,200,0.15)_0%,_transparent_70%)]"></div>
        <div class="absolute bottom-0 right-0 w-[600px] h-[400px] bg-[radial-gradient(ellipse_at_center,_rgba(0,200,255,0.1)_0%,_transparent_70%)]"></div>
      </div>
      
      <div class="relative mx-auto max-w-7xl px-6 text-center">
        <h1 class="font-display text-7xl sm:text-8xl lg:text-9xl font-black tracking-tighter leading-[0.85]">
          <span class="text-white">BEEK</span><span class="bg-gradient-to-r from-emerald-400 via-cyan-400 to-emerald-400 bg-clip-text text-transparent">ONZ</span>
        </h1>
        
        <p class="mx-auto mt-8 max-w-3xl text-xl sm:text-2xl text-gray-400 leading-relaxed">
          Full Body Tracking de nueva generación. Trackers ultraligeros de <span class="text-emerald-400 font-semibold">10g</span> con <span class="text-emerald-400 font-semibold">+50h</span> de batería para VRChat.
        </p>
        
        <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={PACKS[2].stripe}
            target="_blank"
            rel="noopener"
            class="px-10 py-4 bg-gradient-to-r from-emerald-500 to-cyan-500 rounded-full font-bold text-black text-lg transition-all hover:scale-105 hover:shadow-[0_0_40px_rgba(0,255,200,0.4)]"
          >
            Comprar Ahora
          </a>
          <a href="#packs" class="px-10 py-4 border border-white/20 rounded-full font-semibold text-white text-lg transition-all hover:border-emerald-400 hover:text-emerald-400">
            Ver Packs
          </a>
        </div>
        
        <!-- Pantallas flotantes estilo Fantom UI -->
        <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-4">
          {[
            { img: "/images/product_blackopen-D4FUIUW9.png", alt: "Tracker abierto" },
            { img: "/images/product_blackclose-DG-ax_eH.png", alt: "Tracker cerrado" },
            { img: "/images/hero-tracker-CAzRrDY8.jpg", alt: "Hero tracker" },
            { img: "/images/tracker-lifestyle-BLmfpVMs.jpg", alt: "Estilo de vida" },
          ].map((item, i) => (
            <div 
              class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl transition-all duration-500 hover:scale-105 hover:shadow-[0_0_30px_rgba(0,255,200,0.2)]"
              style={`animation: float ${4 + i}s ease-in-out infinite; animation-delay: ${i * 0.5}s`}
            >
              <img src={item.img} alt={item.alt} class="w-full aspect-square object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ CARACTERÍSTICAS - ICONOS FLOTANTES ═══════════ -->
    <section class="py-32 bg-[#0f0f1a]">
      <div class="mx-auto max-w-7xl px-6">
        <div class="text-center mb-16">
          <h2 class="font-display text-4xl sm:text-5xl font-black text-white">¿Por qué <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">Beekonz</span>?</h2>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {FEATURES.map((f) => (
            <div class="relative rounded-2xl border border-white/5 bg-white/[0.02] p-8 text-center transition-all duration-300 hover:border-emerald-500/30 hover:bg-white/[0.04] hover:scale-105">
              <p class="font-display text-4xl font-black text-emerald-400">{f.stat}</p>
              <h3 class="font-display mt-3 font-bold text-white">{f.title}</h3>
              <p class="mt-2 text-sm text-gray-500">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ PACKS - TARJETAS HORIZONTALES ═══════════ -->
    <section id="packs" class="py-32 bg-[#0a0a0f]">
      <div class="mx-auto max-w-7xl px-6">
        <div class="text-center mb-16">
          <h2 class="font-display text-4xl sm:text-5xl font-black text-white">Elige tu <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">Pack</span></h2>
        </div>
        
        <div class="grid gap-6 lg:grid-cols-3">
          {PACKS.map((pack) => (
            <div
              class:list={[
                "relative flex flex-col rounded-3xl border p-8 transition-all duration-300",
                pack.recommended
                  ? "border-emerald-500/50 bg-gradient-to-b from-emerald-500/10 to-white/[0.02] scale-105 shadow-[0_0_50px_rgba(0,255,200,0.2)]"
                  : "border-white/5 bg-white/[0.02] hover:border-emerald-500/30",
              ]}
            >
              {pack.recommended && (
                <p class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-emerald-500 to-cyan-500 px-4 py-1 text-xs font-bold text-black uppercase">
                  Más Popular
                </p>
              )}
              <div class="flex items-center gap-4">
                <p class="font-display text-5xl font-black text-white">{pack.trackers}</p>
                <div>
                  <h3 class="font-display text-xl font-bold text-white">{pack.name}</h3>
                  <p class="text-sm text-gray-500">{pack.tagline}</p>
                </div>
              </div>
              <p class="font-display mt-6 text-4xl font-black text-white">{pack.price}<span class="text-base font-medium text-gray-500"> MXN</span></p>
              <ul class="mt-6 flex-1 space-y-3">
                {pack.includes.map((item) => (
                  <li class="flex items-center gap-3 text-sm text-gray-300">
                    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400">✓</span>
                    {item}
                  </li>
                ))}
              </ul>
              <a
                href={pack.stripe}
                target="_blank"
                rel="noopener"
                class:list={[
                  "mt-6 block rounded-full py-3 text-center font-bold transition-all",
                  pack.recommended
                    ? "bg-gradient-to-r from-emerald-500 to-cyan-500 text-black hover:shadow-[0_0_30px_rgba(0,255,200,0.4)]"
                    : "border border-white/10 text-white hover:border-emerald-500",
                ]}
              >
                Comprar
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ TESTIMONIOS - CARRUSEL ═══════════ -->
    <section class="py-32 bg-[#0f0f1a]">
      <div class="mx-auto max-w-7xl px-6">
        <div class="text-center mb-16">
          <h2 class="font-display text-4xl sm:text-5xl font-black text-white">Lo que dicen <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">nuestros usuarios</span></h2>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {TESTIMONIALS.map((t) => (
            <blockquote class="flex flex-col rounded-2xl border border-white/5 bg-white/[0.02] p-8 transition-all hover:border-emerald-500/30">
              <p class="text-yellow-400 text-xl">★★★★★</p>
              <p class="mt-6 flex-1 text-lg text-gray-300 italic">"{t.quote}"</p>
              <footer class="mt-6 flex items-center gap-4">
                <img src={t.img} alt={t.name} loading="lazy" class="h-12 w-12 rounded-full object-cover border-2 border-emerald-500/30" />
                <div>
                  <p class="font-bold text-white">{t.name}</p>
                  <p class="text-sm text-gray-500">{t.role}</p>
                </div>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ FAQ ═══════════ -->
    <section class="py-32 bg-[#0a0a0f]">
      <div class="mx-auto max-w-3xl px-6">
        <div class="text-center mb-16">
          <h2 class="font-display text-4xl sm:text-5xl font-black text-white">Preguntas <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">Frecuentes</span></h2>
        </div>
        <div class="space-y-4">
          {FAQ.map((f) => (
            <details class="group rounded-xl border border-white/5 bg-white/[0.02] transition-all hover:border-emerald-500/30">
              <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 font-medium text-white text-lg [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-emerald-400 text-2xl transition group-open:rotate-45">+</span>
              </summary>
              <p class="px-6 pb-6 text-gray-400">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ CTA FINAL - WAITLIST STYLE ═══════════ -->
    <section class="py-32 bg-[#0f0f1a]">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <h2 class="font-display text-4xl sm:text-5xl font-black text-white">¿Listo para <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">empezar</span>?</h2>
        <p class="mx-auto mt-6 max-w-xl text-lg text-gray-400">
          Únete a más de 150 creadores VR que ya usan Beekonz.
        </p>
        <div class="mt-10">
          <a href={PACKS[1].stripe} target="_blank" rel="noopener" class="inline-block px-12 py-4 bg-gradient-to-r from-emerald-500 to-cyan-500 rounded-full font-bold text-black text-lg transition-all hover:scale-105 hover:shadow-[0_0_40px_rgba(0,255,200,0.4)]">
            Comprar Ahora
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
