---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  SITE,
  STATS,
  PACKS,
  FACE_TRACKING,
  FEATURES,
  GALLERY,
  TESTIMONIALS,
  TRAYECTORIA,
  FAQ,
} from "../data/store";
---

<Base>
  <Header />

  <main class="bg-[#F8F4F5] text-[#2E0F12] overflow-hidden">
    <!-- ═══════════ HERO - ESTILO EDITORIAL ═══════════ -->
    <section class="relative min-h-screen flex items-center pt-32 pb-20">
      <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-sm font-semibold tracking-widest text-[#7D706E] uppercase mb-6">Full Body Tracking VR</p>
          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[0.95]">
            Precisión que<br />se siente.<br />
            <span class="text-[#EAD08E]">Libertad que se vive.</span>
          </h1>
          <p class="mt-8 text-lg text-[#4A2C2C] leading-relaxed max-w-lg">
            Trackers ultraligeros de 10g con +50h de batería. Diseñados para creadores serios de VRChat.
          </p>
          <div class="mt-10 flex flex-col sm:flex-row gap-4">
            <a href={PACKS[2].stripe} target="_blank" rel="noopener" class="px-8 py-4 bg-[#2E0F12] rounded-full font-bold text-[#F8F4F5] text-center transition hover:scale-105 hover:shadow-xl">
              Comprar Ahora
            </a>
            <a href="#packs" class="px-8 py-4 border border-[#2E0F12]/20 rounded-full font-semibold text-[#2E0F12] text-center transition hover:border-[#EAD08E]">
              Ver Packs
            </a>
          </div>
        </div>
        
        <div class="relative">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl">
            <img src="/images/hero-tracker-CAzRrDY8.jpg" alt="Beekonz Tracker" class="w-full aspect-[4/5] object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#2E0F12]/30 to-transparent"></div>
          </div>
          <div class="absolute -bottom-6 -left-6 bg-[#EAD08E] rounded-2xl p-6 shadow-xl">
            <p class="font-display text-3xl font-black text-[#2E0F12]">10g</p>
            <p class="text-sm text-[#2E0F12]/70">Ultra ligero</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ STATS - BARRA HORIZONTAL ═══════════ -->
    <section class="py-16 bg-[#2E0F12]">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          {STATS.map((s) => (
            <div class="text-center">
              <p class="font-display text-4xl sm:text-5xl font-black text-[#EAD08E]">{s.value}</p>
              <p class="mt-2 text-sm text-[#F8F4F5]/60 uppercase tracking-wider">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ CARACTERÍSTICAS - GRID MINIMALISTA ═══════════ -->
    <section id="tecnologia" class="py-32">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-20">
          <p class="text-sm font-semibold tracking-widest text-[#7D706E] uppercase mb-4">Especificaciones</p>
          <h2 class="font-display text-4xl sm:text-5xl font-black tracking-tight">Diseñado para <span class="text-[#EAD08E]">rendir</span></h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {FEATURES.map((f) => (
            <div class="border-t border-[#2E0F12]/10 pt-6">
              <p class="font-display text-3xl font-black text-[#EAD08E]">{f.stat}</p>
              <h3 class="font-display mt-3 font-bold text-lg">{f.title}</h3>
              <p class="mt-2 text-sm text-[#7D706E]">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ FACE TRACKING - LAYOUT ASIMÉTRICO ═══════════ -->
    <section id="face-tracking" class="py-32 bg-[#2E0F12]">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <p class="inline-block rounded-full bg-[#EAD08E] px-4 py-1 text-xs font-bold text-[#2E0F12] uppercase mb-6">
              Nuevo Producto
            </p>
            <h2 class="font-display text-4xl sm:text-5xl font-black text-white">Beekonz <span class="text-[#EAD08E]">Face Tracking</span></h2>
            <p class="mt-6 text-lg text-[#F8F4F5]/70">{FACE_TRACKING.description}</p>
            <p class="font-display mt-8 text-4xl font-black text-white">{FACE_TRACKING.price}<span class="text-lg font-medium text-[#F8F4F5]/50"> MXN</span></p>
            
            <ul class="mt-8 space-y-4">
              {FACE_TRACKING.includes.map((item) => (
                <li class="flex items-center gap-3 text-[#F8F4F5]">
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#EAD08E]/20 text-[#EAD08E]">✓</span>
                  {item}
                </li>
              ))}
            </ul>
            
            <a href={FACE_TRACKING.stripe} target="_blank" rel="noopener" class="mt-10 inline-block px-8 py-4 bg-[#EAD08E] rounded-full font-bold text-[#2E0F12] transition hover:scale-105">
              Comprar ahora
            </a>
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            {FACE_TRACKING.images.slice(0, 4).map((img) => (
              <figure class="rounded-2xl overflow-hidden">
                <img src={img.src} alt={img.alt} loading="lazy" class="w-full aspect-square object-cover transition hover:scale-105" />
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ PACKS - TARJETAS VERTICALES ELEGANTES ═══════════ -->
    <section id="packs" class="py-32">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-20">
          <p class="text-sm font-semibold tracking-widest text-[#7D706E] uppercase mb-4">Nuestros Paquetes</p>
          <h2 class="font-display text-4xl sm:text-5xl font-black tracking-tight">Elige tu <span class="text-[#EAD08E]">configuración</span></h2>
        </div>
        
        <div class="grid gap-8 lg:grid-cols-3">
          {PACKS.map((pack) => (
            <div
              class:list={[
                "relative flex flex-col rounded-3xl border p-10 transition-all duration-300",
                pack.recommended
                  ? "border-[#EAD08E] bg-[#2E0F12] text-white scale-105 shadow-2xl"
                  : "border-[#2E0F12]/10 bg-white hover:border-[#EAD08E]/50 hover:shadow-xl",
              ]}
            >
              {pack.recommended && (
                <p class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-[#EAD08E] px-4 py-1 text-xs font-bold text-[#2E0F12] uppercase">
                  Recomendado
                </p>
              )}
              <p class="font-display text-6xl font-black">{pack.trackers}</p>
              <h3 class="font-display mt-2 text-2xl font-bold">{pack.name}</h3>
              <p class="mt-1 text-sm text-opacity-60">{pack.tagline}</p>
              <p class="font-display mt-6 text-4xl font-black">{pack.price}<span class="text-base font-medium opacity-60"> MXN</span></p>
              <ul class="mt-8 flex-1 space-y-3">
                {pack.includes.map((item) => (
                  <li class="flex items-start gap-3 text-sm">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#EAD08E]/20 text-[#EAD08E]">✓</span>
                    {item}
                  </li>
                ))}
              </ul>
              <a
                href={pack.stripe}
                target="_blank"
                rel="noopener"
                class:list={[
                  "mt-8 block rounded-full py-4 text-center font-bold transition-all",
                  pack.recommended
                    ? "bg-[#EAD08E] text-[#2E0F12] hover:shadow-[0_0_30px_rgba(234,208,142,0.4)]"
                    : "border border-[#2E0F12]/20 text-[#2E0F12] hover:border-[#EAD08E] hover:bg-[#EAD08E] hover:text-[#2E0F12]",
                ]}
              >
                Comprar ahora
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ GALERÍA - MASONRY ═══════════ -->
    <section class="py-32 bg-[#2E0F12]">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-sm font-semibold tracking-widest text-[#EAD08E] uppercase mb-4">Galería</p>
          <h2 class="font-display text-4xl sm:text-5xl font-black text-white">Productos <span class="text-[#EAD08E]">Reales</span></h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {GALLERY.map((g, i) => (
            <figure class={["group overflow-hidden rounded-2xl", i === 0 && "md:col-span-2 md:row-span-2"].filter(Boolean).join(" ")}>
              <img src={g.src} alt={g.caption} loading="lazy" class="w-full h-full object-cover transition duration-500 group-hover:scale-110" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ TESTIMONIOS - MINIMALISTA ═══════════ -->
    <section class="py-32">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-sm font-semibold tracking-widest text-[#7D706E] uppercase mb-4">Testimonios</p>
          <h2 class="font-display text-4xl sm:text-5xl font-black tracking-tight">Lo que dicen <span class="text-[#EAD08E]">nuestros usuarios</span></h2>
        </div>
        <div class="grid gap-8 md:grid-cols-3">
          {TESTIMONIALS.map((t) => (
            <blockquote class="border-t border-[#2E0F12]/10 pt-8">
              <p class="text-yellow-500 text-lg">★★★★★</p>
              <p class="mt-6 text-lg text-[#4A2C2C] italic">"{t.quote}"</p>
              <footer class="mt-6 flex items-center gap-4">
                <img src={t.img} alt={t.name} loading="lazy" class="h-12 w-12 rounded-full object-cover" />
                <div>
                  <p class="font-bold text-[#2E0F12]">{t.name}</p>
                  <p class="text-sm text-[#7D706E]">{t.role} · {t.country}</p>
                </div>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ FAQ ═══════════ -->
    <section class="py-32 bg-[#2E0F12]">
      <div class="max-w-3xl mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-sm font-semibold tracking-widest text-[#EAD08E] uppercase mb-4">Preguntas Frecuentes</p>
          <h2 class="font-display text-4xl sm:text-5xl font-black text-white">¿Tienes Dudas?</h2>
        </div>
        <div class="space-y-4">
          {FAQ.map((f) => (
            <details class="group rounded-xl border border-white/10 bg-white/[0.02] transition-all hover:border-[#EAD08E]/30">
              <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 font-medium text-white text-lg [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-[#EAD08E] text-2xl transition group-open:rotate-45">+</span>
              </summary>
              <p class="px-6 pb-6 text-[#F8F4F5]/60">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ CTA FINAL ═══════════ -->
    <section class="py-32">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight">
          ¿Listo para <span class="text-[#EAD08E]">empezar</span>?
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-lg text-[#4A2C2C]">
          Únete a más de 150 creadores VR que ya usan Beekonz.
        </p>
        <div class="mt-10">
          <a href={PACKS[1].stripe} target="_blank" rel="noopener" class="inline-block px-12 py-4 bg-[#2E0F12] rounded-full font-bold text-[#F8F4F5] text-lg transition-all hover:scale-105 hover:shadow-xl">
            Comprar Ahora
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
