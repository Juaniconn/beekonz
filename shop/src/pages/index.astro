---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  SITE,
  STATS,
  PACKS,
  FACE_TRACKING,
  FEATURES,
  GALLERY,
  TESTIMONIALS,
  TRAYECTORIA,
  FAQ,
} from "../data/store";
---

<Base>
  <Header />

  <main>
    <!-- ═══════════ HERO ═══════════ -->
    <section class="relative overflow-hidden pt-32 pb-20 sm:pt-40">
      <div class="pointer-events-none absolute inset-0">
        <img
          src="/images/hero-tracker-CAzRrDY8.jpg"
          alt=""
          class="h-full w-full object-cover opacity-25"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-hive-950/60 via-hive-950/85 to-hive-950"></div>
      </div>
      <div class="relative mx-auto max-w-7xl px-4 text-center sm:px-6">
        <p class="inline-block rounded-full border border-bee-400/30 bg-bee-400/10 px-4 py-1 text-xs font-semibold tracking-widest text-bee-400 uppercase">
          Tracking VR de Nueva Generación
        </p>
        <h1 class="font-display mx-auto mt-6 max-w-4xl text-5xl leading-[1.05] font-bold tracking-tight sm:text-7xl">
          FULL BODY<br />TRACKING <span class="text-gradient-bee">SIN LÍMITES.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-300">
          Captura cada movimiento con precisión cinematográfica. Trackers Beekonz y Face Tracking
          diseñados para creadores serios de VRChat.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={PACKS[2].stripe}
            target="_blank"
            rel="noopener"
            class="glow-bee rounded-full bg-bee-400 px-8 py-3.5 font-display font-bold text-hive-950 transition hover:bg-bee-300"
          >
            Comprar Ahora
          </a>
          <a href="#tecnologia" class="rounded-full border border-white/15 px-8 py-3.5 font-display font-semibold text-white transition hover:border-bee-400 hover:text-bee-400">
            Cómo Funciona
          </a>
        </div>
        <!-- Stats -->
        <div class="mx-auto mt-16 grid max-w-4xl grid-cols-2 gap-6 sm:grid-cols-4">
          {STATS.map((s) => (
            <div>
              <p class="font-display text-3xl font-bold text-bee-400 sm:text-4xl">{s.value}</p>
              <p class="mt-1 text-xs tracking-wide text-neutral-400 uppercase">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ CARACTERÍSTICAS ═══════════ -->
    <section id="tecnologia" class="py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <p class="text-center text-xs font-semibold tracking-widest text-bee-400 uppercase">Especificaciones</p>
        <h2 class="font-display mt-3 text-center text-3xl font-bold sm:text-5xl">
          Características <span class="text-gradient-bee">Principales</span>
        </h2>
        <p class="mt-3 text-center text-neutral-400">Especificaciones que marcan la diferencia.</p>
        <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {FEATURES.map((f) => (
            <div class="rounded-2xl border border-white/8 bg-hive-900/50 p-6 transition hover:border-bee-400/40 hover:bg-hive-800/60">
              <p class="font-display text-2xl font-bold text-bee-400">{f.stat}</p>
              <h3 class="font-display mt-3 font-semibold text-white">{f.title}</h3>
              <p class="mt-2 text-sm text-neutral-400">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ FACE TRACKING ═══════════ -->
    <section id="face-tracking" class="border-y border-bee-400/15 bg-gradient-to-b from-hive-900/70 to-transparent py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="text-center">
          <p class="inline-block rounded-full bg-bee-400 px-4 py-1 text-xs font-bold tracking-widest text-hive-950 uppercase">
            🐝 Nuevo Producto
          </p>
          <h2 class="font-display mt-4 text-3xl font-bold sm:text-5xl">Beekonz <span class="text-gradient-bee">Face Tracking</span></h2>
          <p class="mx-auto mt-4 max-w-2xl text-neutral-300">{FACE_TRACKING.description}</p>
          <p class="font-display mt-6 text-4xl font-bold text-bee-400">{FACE_TRACKING.price}<span class="text-base font-medium text-neutral-400"> MXN</span></p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {FACE_TRACKING.images.map((img, i) => (
            <figure class:list={["overflow-hidden rounded-2xl border border-white/8", i === 0 && "sm:col-span-2"]}>
              <img src={img.src} alt={img.alt} loading="lazy" class="aspect-[4/3] w-full object-cover transition duration-500 hover:scale-105" />
            </figure>
          ))}
        </div>

        <div class="mt-12 grid items-center gap-10 lg:grid-cols-2">
          <div>
            <h3 class="font-display text-xl font-semibold">El paquete incluye</h3>
            <ul class="mt-4 space-y-3">
              {FACE_TRACKING.includes.map((item) => (
                <li class="flex items-center gap-3 text-neutral-200">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-bee-400/15 text-sm text-bee-400">✓</span>
                  {item}
                </li>
              ))}
            </ul>
            <a
              href={FACE_TRACKING.stripe}
              target="_blank"
              rel="noopener"
              class="glow-bee mt-8 inline-block rounded-full bg-bee-400 px-8 py-3.5 font-display font-bold text-hive-950 transition hover:bg-bee-300"
            >
              Comprar ahora
            </a>
            <p class="mt-3 text-xs text-neutral-500">Pago seguro · Envíos a todo el mundo</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {FACE_TRACKING.features.slice(0, 4).map((f) => (
              <div class="rounded-xl border border-white/8 bg-hive-900/50 p-5">
                <p class="text-xl">{f.icon}</p>
                <h4 class="mt-2 font-semibold text-white">{f.title}</h4>
                <p class="mt-1 text-sm text-neutral-400">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Cómo funciona -->
        <div class="mt-16">
          <h3 class="font-display text-center text-2xl font-bold">Cómo funciona — <span class="text-gradient-bee">3 pasos y listo</span></h3>
          <div class="mt-10 grid gap-6 md:grid-cols-3">
            {FACE_TRACKING.steps.map((s) => (
              <div class="relative rounded-2xl border border-white/8 bg-hive-900/50 p-8 text-center">
                <p class="font-display absolute -top-5 left-1/2 flex h-10 w-10 -translate-x-1/2 items-center justify-center rounded-full bg-bee-400 font-bold text-hive-950">{s.n}</p>
                <h4 class="font-display mt-4 font-semibold text-white">{s.title}</h4>
                <p class="mt-2 text-sm text-neutral-400">{s.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ PACKS ═══════════ -->
    <section id="packs" class="py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <p class="text-center text-xs font-semibold tracking-widest text-bee-400 uppercase">Nuestros Paquetes</p>
        <h2 class="font-display mt-3 text-center text-3xl font-bold sm:text-5xl">Beekonz <span class="text-gradient-bee">Trackers</span></h2>
        <p class="mt-3 text-center text-neutral-400">Elige el pack perfecto para tu experiencia VR. Todos incluyen dongle NRF optimizado.</p>
        <div class="mt-14 grid gap-6 lg:grid-cols-3">
          {PACKS.map((pack) => (
            <div
              class:list={[
                "relative flex flex-col rounded-3xl border p-8",
                pack.recommended
                  ? "glow-bee border-bee-400/60 bg-gradient-to-b from-bee-400/10 to-hive-900/60 lg:-my-4 lg:py-12"
                  : "border-white/8 bg-hive-900/50",
              ]}
            >
              {pack.recommended && (
                <p class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-bee-400 px-4 py-1 text-xs font-bold tracking-wide text-hive-950 uppercase">
                  Recomendado
                </p>
              )}
              <p class="font-display text-5xl font-bold text-bee-400/90">{pack.trackers}</p>
              <h3 class="font-display mt-2 text-2xl font-bold">{pack.name}</h3>
              <p class="mt-1 text-sm text-neutral-400">{pack.tagline}</p>
              <p class="font-display mt-5 text-4xl font-bold">{pack.price}<span class="text-base font-medium text-neutral-400"> MXN</span></p>
              <ul class="mt-6 flex-1 space-y-3">
                {pack.includes.map((item) => (
                  <li class="flex items-start gap-3 text-sm text-neutral-200">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-bee-400/15 text-[11px] text-bee-400">✓</span>
                    {item}
                  </li>
                ))}
              </ul>
              <a
                href={pack.stripe}
                target="_blank"
                rel="noopener"
                class:list={[
                  "mt-8 block rounded-full py-3.5 text-center font-display font-bold transition",
                  pack.recommended
                    ? "bg-bee-400 text-hive-950 hover:bg-bee-300"
                    : "border border-bee-400/40 text-bee-400 hover:bg-bee-400 hover:text-hive-950",
                ]}
              >
                Comprar ahora
              </a>
            </div>
          ))}
        </div>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-neutral-400">
          <span>✅ Compatible SlimeVR</span>
          <span>🎮 VRChat & SteamVR</span>
          <span>📦 Envío incluido</span>
        </div>
      </div>
    </section>

    <!-- ═══════════ SET PERSONALIZADO ═══════════ -->
    <section class="px-4 sm:px-6">
      <div class="glow-bee relative mx-auto max-w-7xl overflow-hidden rounded-3xl border border-bee-400/20">
        <img src="/images/tracker-lifestyle-BLmfpVMs.jpg" alt="Set personalizado Beekonz" class="absolute inset-0 h-full w-full object-cover opacity-20" loading="lazy" />
        <div class="relative bg-hive-900/80 px-8 py-16 text-center backdrop-blur-sm sm:px-16">
          <h2 class="font-display text-3xl font-bold sm:text-4xl">¿Set <span class="text-gradient-bee">Personalizado</span>?</h2>
          <p class="mx-auto mt-4 max-w-xl text-neutral-300">
            ¿Necesitas una configuración específica? Nuestro equipo puede ayudarte a crear un set perfecto para tu espacio, estilo de juego y necesidades.
          </p>
          <ul class="mx-auto mt-6 grid max-w-md gap-2 text-left text-sm text-neutral-200">
            {["Configuración adaptada a tu espacio de VR", "Optimizado para tu estilo de juego", "Soporte dedicado del equipo Beekonz"].map((t) => (
              <li class="flex items-center gap-3"><span class="text-bee-400">✦</span>{t}</li>
            ))}
          </ul>
          <a
            href={SITE.discord}
            target="_blank"
            rel="noopener"
            class="mt-8 inline-block rounded-full bg-bee-400 px-8 py-3.5 font-display font-bold text-hive-950 transition hover:bg-bee-300"
          >
            Crear mi Set en Discord
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════ TRAYECTORIA ═══════════ -->
    <section class="py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <p class="text-center text-xs font-semibold tracking-widest text-bee-400 uppercase">Experiencia & Trayectoria</p>
        <h2 class="font-display mt-3 text-center text-3xl font-bold sm:text-5xl">Más de <span class="text-gradient-bee">3 Años de Experiencia</span></h2>
        <p class="mx-auto mt-4 max-w-2xl text-center text-neutral-400">
          Beekonz se ha consolidado como una marca confiable y apreciada en la comunidad VR. Nuestros clientes nos eligen por nuestra precisión, atención humana y personalización avanzada.
        </p>
        <div class="mt-14 grid grid-cols-2 gap-6 lg:grid-cols-4">
          {TRAYECTORIA.map((t) => (
            <div class="rounded-2xl border border-white/8 bg-hive-900/50 p-6 text-center">
              <p class="font-display text-4xl font-bold text-bee-400">{t.value}</p>
              <p class="font-display mt-2 font-semibold text-white">{t.label}</p>
              <p class="mt-1 text-sm text-neutral-500">{t.sub}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ GALERÍA ═══════════ -->
    <section id="galeria" class="border-y border-white/5 bg-hive-900/40 py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <p class="text-center text-xs font-semibold tracking-widest text-bee-400 uppercase">Galería</p>
        <h2 class="font-display mt-3 text-center text-3xl font-bold sm:text-5xl">Productos Reales <span class="text-gradient-bee">Beekonz</span></h2>
        <p class="mt-3 text-center text-neutral-400">Fotografías reales de nuestros kits, ediciones especiales y accesorios.</p>
        <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {GALLERY.map((g) => (
            <figure class="group overflow-hidden rounded-2xl border border-white/8">
              <img src={g.src} alt={g.caption} loading="lazy" class="aspect-square w-full object-cover transition duration-500 group-hover:scale-105" />
              <figcaption class="bg-hive-950/80 px-4 py-3 text-sm text-neutral-300">{g.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ TESTIMONIOS ═══════════ -->
    <section class="py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <p class="text-center text-xs font-semibold tracking-widest text-bee-400 uppercase">Testimonios</p>
        <h2 class="font-display mt-3 text-center text-3xl font-bold sm:text-5xl">Lo que dicen <span class="text-gradient-bee">nuestros usuarios</span></h2>
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {TESTIMONIALS.map((t) => (
            <blockquote class="flex flex-col rounded-2xl border border-white/8 bg-hive-900/50 p-8">
              <p class="text-yellow-400">★★★★★</p>
              <p class="mt-4 flex-1 text-neutral-200">"{t.quote}"</p>
              <footer class="mt-6 flex items-center gap-4">
                <img src={t.img} alt={`Kit Beekonz de ${t.name}`} loading="lazy" class="h-12 w-12 rounded-full object-cover" />
                <div>
                  <p class="font-display font-semibold text-white">{t.name}</p>
                  <p class="text-xs text-neutral-500">{t.role} · {t.country}</p>
                </div>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ ENVÍOS ═══════════ -->
    <section class="border-y border-white/5 bg-hive-900/40 py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <p class="text-center text-xs font-semibold tracking-widest text-bee-400 uppercase">Logística Nacional & Internacional</p>
        <h2 class="font-display mt-3 text-center text-3xl font-bold sm:text-5xl">Envíos a toda la <span class="text-gradient-bee">República Mexicana</span></h2>
        <p class="mx-auto mt-4 max-w-2xl text-center text-neutral-400">
          Centro logístico en Ciudad de México con cobertura a los 32 estados. También realizamos envíos internacionales a más de 12 países.
        </p>
        <div class="mx-auto mt-14 grid max-w-3xl grid-cols-2 gap-6 sm:grid-cols-4">
          {[["32", "Estados México"], ["2–5", "Días hábiles"], ["12+", "Países"], ["100%", "Tracking incluido"]].map(([v, l]) => (
            <div class="text-center">
              <p class="font-display text-4xl font-bold text-bee-400">{v}</p>
              <p class="mt-1 text-xs tracking-wide text-neutral-400 uppercase">{l}</p>
            </div>
          ))}
        </div>
        <p class="mt-10 text-center text-sm text-neutral-400">
          Cada envío incluye número de rastreo. Consulta tu pedido en la sección de
          <a href="/seguimiento-pedidos" class="text-bee-400 underline underline-offset-2 hover:text-bee-300">Seguimiento de Pedidos</a>.
        </p>
      </div>
    </section>

    <!-- ═══════════ FAQ ═══════════ -->
    <section id="faq" class="py-24">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <p class="text-center text-xs font-semibold tracking-widest text-bee-400 uppercase">Preguntas Frecuentes</p>
        <h2 class="font-display mt-3 text-center text-3xl font-bold sm:text-5xl">¿Tienes Dudas?</h2>
        <div class="mt-12 space-y-3">
          {FAQ.map((f) => (
            <details class="group rounded-xl border border-white/8 bg-hive-900/50 open:border-bee-400/40">
              <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-4 font-medium text-white [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-bee-400 transition group-open:rotate-45">+</span>
              </summary>
              <p class="px-6 pb-5 text-sm text-neutral-300">{f.a}</p>
            </details>
          ))}
        </div>
        <p class="mt-8 text-center text-sm text-neutral-400">
          ¿No encontraste lo que buscabas?
          <a href={SITE.discord} target="_blank" rel="noopener" class="text-bee-400 underline underline-offset-2 hover:text-bee-300">Pregúntanos en Discord</a>
        </p>
      </div>
    </section>

    <!-- ═══════════ CTA FINAL ═══════════ -->
    <section class="px-4 pb-24 sm:px-6">
      <div class="glow-bee mx-auto max-w-5xl rounded-3xl border border-bee-400/20 bg-gradient-to-b from-bee-400/10 to-hive-900/60 px-8 py-16 text-center">
        <p class="inline-flex items-center gap-2 rounded-full border border-bee-400/30 px-4 py-1 text-xs font-semibold text-bee-400">⭐ 4.9/5 · Hecho para la comunidad hispana</p>
        <h2 class="font-display mx-auto mt-5 max-w-2xl text-3xl font-bold sm:text-4xl">
          Lleva tu Experiencia VR al <span class="text-gradient-bee">Siguiente Nivel</span>
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-neutral-300">
          Tracking preciso, ligero y accesible. Diseñado especialmente para bailarines, creadores y la comunidad VRChat hispana.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href={PACKS[1].stripe} target="_blank" rel="noopener" class="glow-bee rounded-full bg-bee-400 px-8 py-3.5 font-display font-bold text-hive-950 transition hover:bg-bee-300">
            Comprar Ahora
          </a>
          <span class="text-sm text-neutral-400">🚚 Envíos a todo el mundo · 5–7 días internacional</span>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Botón flotante Discord -->
  <a
    href={SITE.discord}
    target="_blank"
    rel="noopener"
    aria-label="Únete a nuestro Discord"
    class="fixed right-5 bottom-5 z-50 flex h-13 w-13 items-center justify-center rounded-full bg-bee-400 p-3.5 shadow-lg shadow-black/40 transition hover:bg-bee-300"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="#0a0a05"><path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3c-.2.4-.5.9-.6 1.3a18.3 18.3 0 0 0-5.6 0C9 3.9 8.7 3.4 8.5 3a19.7 19.7 0 0 0-4.9 1.5A20.4 20.4 0 0 0 .1 18.1a19.9 19.9 0 0 0 6 3c.5-.6.9-1.3 1.3-2-.7-.3-1.4-.6-2-1l.5-.4a14.2 14.2 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1 .4.7.8 1.4 1.3 2a19.8 19.8 0 0 0 6-3A20.3 20.3 0 0 0 20.3 4.4ZM8.1 15.3c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm7.8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z"/></svg>
  </a>
</Base>
