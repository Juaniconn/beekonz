---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, PACKS, FACE_TRACKING, FEATURES, GALLERY, TESTIMONIALS, STATS, FAQ } from "../data/store";
---

<Base>
  <Header />

  <main>
    <!-- ═══════════ HERO — Editorial Dark ═══════════ -->
    <section class="hero-dark">
      <div class="container">
        <div class="grid lg:grid-cols-12 gap-12 items-center">
          <!-- Left column — copy -->
          <div class="lg:col-span-7 space-y-8">
            <!-- Badge -->
            <span class="badge">Tracking VR de Nueva Generación</span>

            <!-- Main heading -->
            <h1 class="text-display-xxl text-white">
              FULL BODY<br>
              TRACKING<br>
              <span class="text-gradient-gold">SIN LÍMITES.</span>
            </h1>

            <p class="text-body-lg text-[#d4b8b9] max-w-xl">
              Captura cada movimiento con precisión cinematográfica. Trackers Beekonz y Face Tracking diseñados para creadores serios de <span class="text-white font-medium">VRChat</span>.
            </p>

            <!-- CTA Buttons -->
            <div class="flex flex-col sm:flex-row gap-4">
              <a href={PACKS[2].stripe} target="_blank" rel="noopener" class="btn-primary">
                Comprar Ahora
                <svg class="inline-block ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
              <a href="#tecnologia" class="btn-dark">
                <svg class="inline-block mr-2 w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                Cómo Funciona
              </a>
            </div>

            <!-- Stats -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-8 border-t border-white/10">
              <div>
                <div class="text-display-md text-white">50,000+</div>
                <div class="text-micro uppercase tracking-widest text-[#8b6b6e] mt-1">Horas Trackeadas</div>
              </div>
              <div>
                <div class="text-display-md text-white">32</div>
                <div class="text-micro uppercase tracking-widest text-[#8b6b6e] mt-1">Estados Enviados</div>
              </div>
              <div>
                <div class="text-display-md text-white">12</div>
                <div class="text-micro uppercase tracking-widest text-[#8b6b6e] mt-1">Países</div>
              </div>
              <div>
                <div class="text-display-md text-white">100%</div>
                <div class="text-micro uppercase tracking-widest text-[#8b6b6e] mt-1">Listo VRChat</div>
              </div>
            </div>
          </div>

          <!-- Right column — 3D rotating tracker -->
          <div class="lg:col-span-5 relative hidden lg:block">
            <div class="relative rounded-2xl overflow-hidden border border-white/10 bg-white/5 backdrop-blur-sm h-[600px]">
              <!-- 3D Model Container -->
              <div class="absolute inset-0 flex items-center justify-center" id="hero-3d-model">
                <div class="tracker3d-loading w-16 h-16 rounded-full border-2 border-[#EAD08E]/20 border-t-[#EAD08E] animate-spin"></div>
                <p class="tracker3d-fallback hidden text-sm text-white/40">No se pudo cargar el modelo 3D</p>
              </div>
              <script src="../scripts/tracker3d.ts"></script>

              <!-- Badges -->
              <div class="absolute top-5 left-5 px-3 py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/10 z-10">
                <span class="text-micro uppercase tracking-widest font-semibold text-[#EAD08E]">● Modelo 3D</span>
              </div>
              <div class="absolute top-5 right-5 px-3 py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/10 z-10">
                <span class="text-micro uppercase tracking-widest font-semibold text-white/80">LSM6DSV · 35-45h</span>
              </div>
              
              <!-- Bottom card -->
              <div class="absolute bottom-5 left-5 right-5 p-5 rounded-xl bg-black/60 backdrop-blur-xl border border-white/10 z-10">
                <div class="flex items-center justify-between">
                  <div>
                    <div class="text-micro uppercase tracking-widest text-white/50">Beekonz Pro Kit</div>
                    <div class="font-display text-2xl text-white mt-1">10 TRACKERS</div>
                  </div>
                  <div class="text-right">
                    <div class="text-micro text-white/50">Desde</div>
                    <div class="font-display text-2xl text-[#EAD08E]">$8,999</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ FEATURES — Light Section ═══════════ -->
    <section id="tecnologia" class="section section-light">
      <div class="container">
        <div class="text-center mb-20">
          <p class="text-button-cap font-semibold tracking-widest text-[#EAD08E] uppercase mb-4">Especificaciones</p>
          <h2 class="text-display-xl text-[#2E0F12]">
            Diseñado para <span class="text-gradient-gold">rendir</span>
          </h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {FEATURES.map((f) => (
            <div class="card text-center">
              <p class="text-display-lg font-black text-[#EAD08E]">{f.stat}</p>
              <h3 class="text-heading-lg mt-4 text-[#2E0F12]">{f.title}</h3>
              <p class="mt-3 text-body-md text-[#8b6b6e]">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ FACE TRACKING — Soft Section ═══════════ -->
    <section id="face-tracking" class="section section-soft">
      <div class="container">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <span class="badge mb-6">🐝 Nuevo Producto</span>
            <h2 class="text-display-xl text-[#2E0F12]">Beekonz <span class="text-gradient-gold">Face Tracking</span></h2>
            <p class="mt-6 text-body-lg text-[#8b6b6e]">{FACE_TRACKING.description}</p>
            <p class="font-display mt-8 text-5xl font-black text-[#2E0F12]">{FACE_TRACKING.price}<span class="text-xl font-medium text-[#8b6b6e]"> MXN</span></p>
            
            <ul class="mt-8 space-y-4">
              {FACE_TRACKING.includes.map((item) => (
                <li class="flex items-center gap-4 text-[#2E0F12]">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#EAD08E] text-[#2E0F12]">✓</span>
                  <span class="text-body-lg">{item}</span>
                </li>
              ))}
            </ul>
            
            <a href={FACE_TRACKING.stripe} target="_blank" rel="noopener" class="mt-10 inline-block btn-primary text-lg">
              Comprar ahora
            </a>
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            {FACE_TRACKING.images.slice(0, 4).map((img) => (
              <figure class="overflow-hidden rounded-xl border border-[#EAD08E]/20 transition-all duration-500 hover:border-[#EAD08E] hover:scale-105 group">
                <img src={img.src} alt={img.alt} loading="lazy" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ PACKS — Light Section ═══════════ -->
    <section id="packs" class="section section-light">
      <div class="container">
        <div class="text-center mb-20">
          <p class="text-button-cap font-semibold tracking-widest text-[#EAD08E] uppercase mb-4">Nuestros Paquetes</p>
          <h2 class="text-display-xl text-[#2E0F12]">Elige tu <span class="text-gradient-gold">configuración</span></h2>
        </div>
        
        <div class="grid gap-8 lg:grid-cols-3">
          {PACKS.map((pack) => (
            <div class:list={[
              "relative flex flex-col rounded-2xl p-10 transition-all duration-500",
              pack.recommended
                ? "card-pricing-featured lg:-my-6 lg:py-16"
                : "card-pricing"
            ]}>
              {pack.recommended && (
                <p class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-[#EAD08E] px-6 py-1.5 text-button-cap font-bold text-[#2E0F12] uppercase">
                  Recomendado
                </p>
              )}
              <p class={["text-display-lg font-black", pack.recommended ? "text-white" : "text-[#2E0F12]"]}>{pack.trackers}</p>
              <h3 class={["mt-3 text-2xl font-bold", pack.recommended ? "text-white" : "text-[#2E0F12]"]}>{pack.name}</h3>
              <p class={["mt-2", pack.recommended ? "text-[#d4b8b9]" : "text-[#8b6b6e]"]}>{pack.tagline}</p>
              <p class={["mt-6 text-4xl font-black", pack.recommended ? "text-white" : "text-[#2E0F12]"]}>{pack.price}<span class="text-lg font-medium opacity-60"> MXN</span></p>
              <ul class="mt-8 flex-1 space-y-4">
                {pack.includes.map((item) => (
                  <li class="flex items-start gap-3">
                    <span class={["mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-sm", pack.recommended ? "bg-white/20 text-white" : "bg-[#EAD08E]/20 text-[#2E0F12]"]}>✓</span>
                    <span class={pack.recommended ? "text-white/80" : "text-[#8b6b6e]"}>{item}</span>
                  </li>
                ))}
              </ul>
              <a
                href={pack.stripe}
                target="_blank"
                rel="noopener"
                class={[
                  "mt-10 block rounded-lg py-4 text-center font-bold transition-all duration-300",
                  pack.recommended
                    ? "bg-white text-[#2E0F12] hover:bg-[#F8F4F5]"
                    : "border border-[#2E0F12] text-[#2E0F12] hover:bg-[#2E0F12] hover:text-white",
                ]}
              >
                Comprar ahora
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ GALLERY — Soft Section ═══════════ -->
    <section class="section section-soft">
      <div class="container">
        <div class="text-center mb-16">
          <p class="text-button-cap font-semibold tracking-widest text-[#EAD08E] uppercase mb-4">Galería</p>
          <h2 class="text-display-xl text-[#2E0F12]">Productos <span class="text-gradient-gold">Reales</span></h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {GALLERY.map((g, i) => (
            <figure class={["group overflow-hidden rounded-xl border border-[#EAD08E]/20 transition-all duration-500 hover:border-[#EAD08E] hover:scale-105", i === 0 && "md:col-span-2 md:row-span-2"].filter(Boolean).join(" ")}>
              <img src={g.src} alt={g.caption} loading="lazy" class="w-full h-full object-cover transition duration-700 group-hover:scale-110" />
              <figcaption class="bg-white px-5 py-4 text-caption text-[#8b6b6e] border-t border-[#EAD08E]/20">{g.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ TESTIMONIALS — Light Section ═══════════ -->
    <section class="section section-light">
      <div class="container">
        <div class="text-center mb-16">
          <p class="text-button-cap font-semibold tracking-widest text-[#EAD08E] uppercase mb-4">Testimonios</p>
          <h2 class="text-display-xl text-[#2E0F12]">Lo que dicen <span class="text-gradient-gold">nuestros usuarios</span></h2>
        </div>
        <div class="grid gap-8 md:grid-cols-3">
          {TESTIMONIALS.map((t) => (
            <blockquote class="card flex flex-col">
              <p class="text-[#EAD08E] text-xl">★★★★★</p>
              <p class="mt-6 flex-1 text-body-lg text-[#8b6b6e] italic">"{t.quote}"</p>
              <footer class="mt-8 flex items-center gap-4">
                <img src={t.img} alt={t.name} loading="lazy" class="h-14 w-14 rounded-full object-cover border-2 border-[#EAD08E]/30" />
                <div>
                  <p class="font-bold text-[#2E0F12]">{t.name}</p>
                  <p class="text-caption text-[#8b6b6e]">{t.role} · {t.country}</p>
                </div>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ FAQ — Soft Section ═══════════ -->
    <section class="section section-soft">
      <div class="container max-w-3xl">
        <div class="text-center mb-16">
          <p class="text-button-cap font-semibold tracking-widest text-[#EAD08E] uppercase mb-4">Preguntas Frecuentes</p>
          <h2 class="text-display-xl text-[#2E0F12]">¿Tienes Dudas?</h2>
        </div>
        <div class="space-y-4">
          {FAQ.map((f) => (
            <details class="group rounded-xl border border-[#EAD08E]/20 bg-white transition-all duration-300 hover:border-[#EAD08E]">
              <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 font-medium text-[#2E0F12] text-body-lg [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-[#EAD08E] text-2xl transition group-open:rotate-45">+</span>
              </summary>
              <p class="px-6 pb-6 text-body-md text-[#8b6b6e]">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ CTA FINAL — Dark Band ═══════════ -->
    <section class="cta-band">
      <div class="container max-w-5xl text-center">
        <div class="rounded-2xl border border-[#EAD08E]/20 bg-white/5 backdrop-blur-sm px-8 py-20">
          <span class="inline-flex items-center gap-2 rounded-full border border-[#EAD08E]/30 px-5 py-1.5 text-button-cap font-semibold text-[#EAD08E]">⭐ 4.9/5 · Hecho para la comunidad hispana</span>
          <h2 class="mx-auto mt-6 max-w-3xl text-display-xl text-white">
            Lleva tu VR al <span class="text-gradient-gold">Siguiente Nivel</span>
          </h2>
          <div class="mt-10">
            <a href={PACKS[1].stripe} target="_blank" rel="noopener" class="btn-primary text-lg">
              Comprar Ahora
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Botón flotante Discord -->
  <a
    href={SITE.discord}
    target="_blank"
    rel="noopener"
    aria-label="Únete a nuestro Discord"
    class="fixed right-5 bottom-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#EAD08E] p-3.5 shadow-lg transition-all duration-300 hover:scale-110 hover:shadow-xl"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="#2E0F12"><path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3c-.2.4-.5.9-.6 1.3a18.3 18.3 0 0 0-5.6 0C9 3.9 8.7 3.4 8.5 3a19.7 19.7 0 0 0-4.9 1.5A20.4 20.4 0 0 0 .1 18.1a19.9 19.9 0 0 0 6 3c.5-.6.9-1.3 1.3-2-.7-.3-1.4-.6-2-1l.5-.4a14.2 14.2 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1 .4.7.8 1.4 1.3 2a19.8 19.8 0 0 0 6-3A20.3 20.3 0 0 0 20.3 4.4ZM8.1 15.3c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm7.8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z"/></svg>
  </a>
</Base>
