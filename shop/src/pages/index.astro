---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  SITE,
  STATS,
  PACKS,
  FACE_TRACKING,
  FEATURES,
  GALLERY,
  TESTIMONIALS,
  TRAYECTORIA,
  FAQ,
} from "../data/store";
---

<Base>
  <Header />

  <main>
    <!-- ═══════════ HERO ═══════════ -->
    <section class="relative min-h-screen overflow-hidden flex items-center justify-center pt-20 bg-[#F8F4F5]">
      <!-- Background con patrón sutil -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_#EAD08E_0%,_transparent_50%)] opacity-20"></div>
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(46,15,18,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(46,15,18,0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>
      
      <div class="relative mx-auto max-w-7xl px-4 text-center sm:px-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#EAD08E] bg-[#EAD08E]/10 px-5 py-2 mb-8">
          <span class="w-2 h-2 rounded-full bg-[#EAD08E] animate-pulse"></span>
          <span class="text-sm font-medium text-[#2E0F12] tracking-wider uppercase">Tracking VR de Nueva Generación</span>
        </div>
        
        <h1 class="font-display text-6xl sm:text-8xl lg:text-9xl font-black tracking-tighter leading-[0.9]">
          <span class="text-[#2E0F12]">FULL BODY</span><br />
          <span class="text-[#2E0F12]">TRACKING</span><br />
          <span class="text-gradient-bee">SIN LÍMITES.</span>
        </h1>
        
        <p class="mx-auto mt-8 max-w-2xl text-xl text-[#4A2C2C] leading-relaxed">
          Captura cada movimiento con precisión cinematográfica. Trackers Beekonz y Face Tracking diseñados para creadores serios de VRChat.
        </p>
        
        <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={PACKS[2].stripe}
            target="_blank"
            rel="noopener"
            class="group relative px-10 py-4 bg-[#2E0F12] rounded-full font-bold text-[#F8F4F5] text-lg transition-all hover:scale-105 hover:shadow-[0_0_40px_rgba(46,15,18,0.3)]"
          >
            Comprar Ahora
          </a>
          <a href="#tecnologia" class="px-10 py-4 border border-[#2E0F12]/20 rounded-full font-semibold text-[#2E0F12] text-lg transition-all hover:border-[#EAD08E] hover:shadow-[0_0_20px_rgba(234,208,142,0.2)]">
            Cómo Funciona
          </a>
        </div>
        
        <!-- Stats -->
        <div class="mx-auto mt-24 grid max-w-4xl grid-cols-2 gap-8 sm:grid-cols-4">
          {STATS.map((s) => (
            <div class="text-center">
              <p class="font-display text-4xl sm:text-5xl font-black text-[#2E0F12]">{s.value}</p>
              <p class="mt-2 text-sm text-[#7D706E] uppercase tracking-wider">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
      
      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
        <span class="text-xs text-[#7D706E] uppercase tracking-widest">Scroll</span>
        <div class="w-6 h-10 border-2 border-[#B0A69E] rounded-full flex justify-center pt-2">
          <div class="w-1.5 h-3 bg-[#EAD08E] rounded-full animate-bounce"></div>
        </div>
      </div>
    </section>

    <!-- ═══════════ CARACTERÍSTICAS ═══════════ -->
    <section id="tecnologia" class="py-32 bg-[#2E0F12]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="text-center">
          <p class="text-sm font-semibold tracking-widest text-[#EAD08E] uppercase mb-4">Especificaciones</p>
          <h2 class="font-display text-4xl sm:text-6xl font-black text-[#F8F4F5]">
            Características <span class="text-gradient-bee">Principales</span>
          </h2>
        </div>
        <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {FEATURES.map((f) => (
            <div class="group relative rounded-2xl border border-[#F8F4F5]/10 bg-[#3D1518] p-8 transition-all duration-300 hover:border-[#EAD08E]/30 hover:bg-[#4A2C2C] hover:shadow-[0_0_30px_rgba(234,208,142,0.1)]">
              <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-[#EAD08E]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <div class="relative">
                <p class="font-display text-3xl font-black text-[#EAD08E]">{f.stat}</p>
                <h3 class="font-display mt-4 font-bold text-[#F8F4F5] text-lg">{f.title}</h3>
                <p class="mt-3 text-sm text-[#B0A69E]">{f.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ FACE TRACKING ═══════════ -->
    <section id="face-tracking" class="relative overflow-hidden py-32 bg-gradient-to-b from-[#3D1518] to-[#2E0F12]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="text-center">
          <p class="inline-block rounded-full bg-[#EAD08E] px-6 py-2 text-sm font-bold text-[#2E0F12] mb-6">
            🐝 Nuevo Producto
          </p>
          <h2 class="font-display text-4xl sm:text-6xl font-black text-[#F8F4F5]">Beekonz <span class="text-gradient-bee">Face Tracking</span></h2>
          <p class="mx-auto mt-6 max-w-2xl text-lg text-[#B0A69E]">{FACE_TRACKING.description}</p>
          <p class="font-display mt-8 text-5xl font-black text-[#F8F4F5]">{FACE_TRACKING.price}<span class="text-xl font-medium text-[#7D706E]"> MXN</span></p>
        </div>

        <div class="mt-16 grid gap-8 lg:grid-cols-2 items-center">
          <div class="grid gap-4 sm:grid-cols-2">
            {FACE_TRACKING.images.slice(0, 4).map((img) => (
              <figure class="overflow-hidden rounded-2xl border border-[#F8F4F5]/10 transition-all hover:border-[#EAD08E]/30 hover:shadow-[0_0_20px_rgba(234,208,142,0.1)]">
                <img src={img.src} alt={img.alt} loading="lazy" class="aspect-[4/3] w-full object-cover transition-transform duration-500 hover:scale-105" />
              </figure>
            ))}
          </div>
          <div>
            <h3 class="font-display text-2xl font-bold text-[#F8F4F5]">El paquete incluye</h3>
            <ul class="mt-6 space-y-4">
              {FACE_TRACKING.includes.map((item) => (
                <li class="flex items-center gap-4 text-[#F8F4F5]">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#EAD08E]/20 text-[#EAD08E]">✓</span>
                  <span class="text-lg">{item}</span>
                </li>
              ))}
            </ul>
            <a
              href={FACE_TRACKING.stripe}
              target="_blank"
              rel="noopener"
              class="mt-10 inline-block px-10 py-4 bg-[#EAD08E] rounded-full font-bold text-[#2E0F12] text-lg transition-all hover:scale-105 hover:shadow-[0_0_40px_rgba(234,208,142,0.4)]"
            >
              Comprar ahora
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ PACKS ═══════════ -->
    <section id="packs" class="py-32 bg-[#F8F4F5]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="text-center">
          <p class="text-sm font-semibold tracking-widest text-[#2E0F12] uppercase mb-4">Nuestros Paquetes</p>
          <h2 class="font-display text-4xl sm:text-6xl font-black text-[#2E0F12]">Beekonz <span class="text-gradient-bee">Trackers</span></h2>
        </div>
        
        <div class="mt-16 grid gap-8 lg:grid-cols-3">
          {PACKS.map((pack) => (
            <div
              class:list={[
                "relative flex flex-col rounded-3xl border p-10 transition-all duration-300",
                pack.recommended
                  ? "border-[#EAD08E] bg-gradient-to-b from-[#EAD08E]/10 to-[#F8F4F5] lg:-my-6 lg:py-16 shadow-[0_0_50px_rgba(234,208,142,0.2)]"
                  : "border-[#2E0F12]/10 bg-[#F8F4F5] hover:border-[#EAD08E]/30 hover:shadow-[0_0_30px_rgba(234,208,142,0.1)]",
              ]}
            >
              {pack.recommended && (
                <p class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-[#EAD08E] px-6 py-1.5 text-sm font-bold text-[#2E0F12] uppercase">
                  Recomendado
                </p>
              )}
              <p class="font-display text-6xl font-black text-[#2E0F12]">{pack.trackers}</p>
              <h3 class="font-display mt-3 text-3xl font-bold text-[#2E0F12]">{pack.name}</h3>
              <p class="mt-2 text-[#7D706E]">{pack.tagline}</p>
              <p class="font-display mt-6 text-5xl font-black text-[#2E0F12]">{pack.price}<span class="text-lg font-medium text-[#7D706E]"> MXN</span></p>
              <ul class="mt-8 flex-1 space-y-4">
                {pack.includes.map((item) => (
                  <li class="flex items-start gap-3 text-[#4A2C2C]">
                    <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#EAD08E]/20 text-sm text-[#2E0F12]">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <a
                href={pack.stripe}
                target="_blank"
                rel="noopener"
                class:list={[
                  "mt-10 block rounded-full py-4 text-center font-bold transition-all hover:scale-105",
                  pack.recommended
                    ? "bg-[#2E0F12] text-[#F8F4F5] hover:shadow-[0_0_30px_rgba(46,15,18,0.3)]"
                    : "border border-[#2E0F12]/20 text-[#2E0F12] hover:border-[#EAD08E] hover:bg-[#EAD08E] hover:text-[#2E0F12]",
                ]}
              >
                Comprar ahora
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ TRAYECTORIA ═══════════ -->
    <section class="py-32 bg-[#2E0F12]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="text-center">
          <p class="text-sm font-semibold tracking-widest text-[#EAD08E] uppercase mb-4">Experiencia & Trayectoria</p>
          <h2 class="font-display text-4xl sm:text-6xl font-black text-[#F8F4F5]">Más de <span class="text-gradient-bee">3 Años</span></h2>
        </div>
        <div class="mt-16 grid grid-cols-2 gap-8 lg:grid-cols-4">
          {TRAYECTORIA.map((t) => (
            <div class="rounded-2xl border border-[#F8F4F5]/10 bg-[#3D1518] p-8 text-center transition-all hover:border-[#EAD08E]/30 hover:shadow-[0_0_20px_rgba(234,208,142,0.1)]">
              <p class="font-display text-5xl font-black text-[#EAD08E]">{t.value}</p>
              <p class="font-display mt-3 font-bold text-[#F8F4F5] text-lg">{t.label}</p>
              <p class="mt-2 text-sm text-[#B0A69E]">{t.sub}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ GALERÍA ═══════════ -->
    <section id="galeria" class="py-32 bg-[#F8F4F5]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="text-center">
          <p class="text-sm font-semibold tracking-widest text-[#2E0F12] uppercase mb-4">Galería</p>
          <h2 class="font-display text-4xl sm:text-6xl font-black text-[#2E0F12]">Productos <span class="text-gradient-bee">Reales</span></h2>
        </div>
        <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {GALLERY.map((g) => (
            <figure class="group overflow-hidden rounded-2xl border border-[#2E0F12]/10 transition-all hover:border-[#EAD08E]/30 hover:shadow-[0_0_20px_rgba(234,208,142,0.1)]">
              <img src={g.src} alt={g.caption} loading="lazy" class="aspect-square w-full object-cover transition duration-500 group-hover:scale-110" />
              <figcaption class="bg-[#2E0F12] px-5 py-4 text-sm text-[#F8F4F5]">{g.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ TESTIMONIOS ═══════════ -->
    <section class="py-32 bg-[#2E0F12]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="text-center">
          <p class="text-sm font-semibold tracking-widest text-[#EAD08E] uppercase mb-4">Testimonios</p>
          <h2 class="font-display text-4xl sm:text-6xl font-black text-[#F8F4F5]">Lo que dicen <span class="text-gradient-bee">nuestros usuarios</span></h2>
        </div>
        <div class="mt-16 grid gap-8 md:grid-cols-3">
          {TESTIMONIALS.map((t) => (
            <blockquote class="flex flex-col rounded-2xl border border-[#F8F4F5]/10 bg-[#3D1518] p-10 transition-all hover:border-[#EAD08E]/30 hover:shadow-[0_0_20px_rgba(234,208,142,0.1)]">
              <p class="text-yellow-400 text-xl">★★★★★</p>
              <p class="mt-6 flex-1 text-lg text-[#F8F4F5] italic">"{t.quote}"</p>
              <footer class="mt-8 flex items-center gap-4">
                <img src={t.img} alt={`Kit Beekonz de ${t.name}`} loading="lazy" class="h-14 w-14 rounded-full object-cover border-2 border-[#EAD08E]/30" />
                <div>
                  <p class="font-bold text-[#F8F4F5]">{t.name}</p>
                  <p class="text-sm text-[#B0A69E]">{t.role} · {t.country}</p>
                </div>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ FAQ ═══════════ -->
    <section id="faq" class="py-32 bg-[#F8F4F5]">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <div class="text-center">
          <p class="text-sm font-semibold tracking-widest text-[#2E0F12] uppercase mb-4">Preguntas Frecuentes</p>
          <h2 class="font-display text-4xl sm:text-6xl font-black text-[#2E0F12]">¿Tienes Dudas?</h2>
        </div>
        <div class="mt-14 space-y-4">
          {FAQ.map((f) => (
            <details class="group rounded-xl border border-[#2E0F12]/10 bg-[#F8F4F5] transition-all hover:border-[#EAD08E]/30">
              <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 font-medium text-[#2E0F12] text-lg [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-[#EAD08E] text-2xl transition group-open:rotate-45">+</span>
              </summary>
              <p class="px-6 pb-6 text-[#4A2C2C]">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ CTA FINAL ═══════════ -->
    <section class="py-32 bg-[#2E0F12]">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="rounded-3xl border border-[#EAD08E]/20 bg-gradient-to-b from-[#EAD08E]/10 to-[#3D1518] px-8 py-20 text-center">
          <p class="inline-flex items-center gap-2 rounded-full border border-[#EAD08E]/30 px-5 py-1.5 text-sm font-semibold text-[#EAD08E]">⭐ 4.9/5 · Hecho para la comunidad hispana</p>
          <h2 class="font-display mx-auto mt-6 max-w-3xl text-4xl sm:text-6xl font-black text-[#F8F4F5]">
            Lleva tu VR al <span class="text-gradient-bee">Siguiente Nivel</span>
          </h2>
          <div class="mt-10">
            <a href={PACKS[1].stripe} target="_blank" rel="noopener" class="inline-block px-12 py-4 bg-[#EAD08E] rounded-full font-bold text-[#2E0F12] text-lg transition-all hover:scale-105 hover:shadow-[0_0_40px_rgba(234,208,142,0.4)]">
              Comprar Ahora
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Botón flotante Discord -->
  <a
    href={SITE.discord}
    target="_blank"
    rel="noopener"
    aria-label="Únete a nuestro Discord"
    class="fixed right-5 bottom-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#EAD08E] p-3.5 shadow-[0_0_20px_rgba(234,208,142,0.3)] transition hover:scale-110 hover:shadow-[0_0_30px_rgba(234,208,142,0.5)]"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="#2E0F12"><path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3c-.2.4-.5.9-.6 1.3a18.3 18.3 0 0 0-5.6 0C9 3.9 8.7 3.4 8.5 3a19.7 19.7 0 0 0-4.9 1.5A20.4 20.4 0 0 0 .1 18.1a19.9 19.9 0 0 0 6 3c.5-.6.9-1.3 1.3-2-.7-.3-1.4-.6-2-1l.5-.4a14.2 14.2 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1 .4.7.8 1.4 1.3 2a19.8 19.8 0 0 0 6-3A20.3 20.3 0 0 0 20.3 4.4ZM8.1 15.3c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm7.8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z"/></svg>
  </a>
</Base>
