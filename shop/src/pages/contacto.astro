---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Contacto | Beekonz" description="Únete a la comunidad Beekonz en Discord. Soporte 24/7, novedades y más.">
  <Header />

  <main class="min-h-screen bg-[#F8F4F5]">
    <div class="pt-32 pb-20 relative overflow-hidden">
      {/* Background effects */}
      <div class="absolute inset-0 grid-pattern opacity-15"></div>
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-[#EAD08E]/10 rounded-full blur-[150px]"></div>
      <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-[#2E0F12]/10 rounded-full blur-[100px]"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto">
          {/* Hero */}
          <div class="text-center mb-16 animate-fade-in">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#EAD08E]/10 border border-[#EAD08E]/30 mb-6">
              <svg class="w-4 h-4 text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
              <span class="text-sm font-medium text-[#2E0F12] tracking-wider uppercase">Comunidad</span>
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold mb-6 text-[#2E0F12]">
              Únete a Nuestra <span class="text-[#EAD08E]">Comunidad</span>
            </h1>
            <p class="text-xl text-[#4A2C2C] max-w-2xl mx-auto">
              ¿Tienes preguntas? Únete a nuestro servidor de Discord para obtener soporte y conectar con otros usuarios.
            </p>
          </div>

          {/* Main Discord Card */}
          <div
            class="relative bg-white border border-[#2E0F12]/10 rounded-3xl p-10 md:p-14 mb-12 animate-fade-in overflow-hidden group hover:border-[#EAD08E]/40 transition-all duration-500"
            style="animation-delay: 0.1s"
          >
            {/* Background glow */}
            <div class="absolute inset-0 bg-gradient-to-br from-[#EAD08E]/10 via-transparent to-[#EAD08E]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <div class="relative z-10 text-center">
              <div class="inline-flex items-center justify-center w-24 h-24 bg-[#EAD08E]/20 rounded-3xl mb-8 group-hover:scale-110 transition-transform duration-500">
                <svg class="h-12 w-12 text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              </div>

              <h2 class="text-3xl md:text-4xl font-display font-bold mb-4 text-[#2E0F12]">Discord Beekonz</h2>
              <p class="text-[#4A2C2C] mb-8 max-w-lg mx-auto text-lg">
                Únete a nuestra comunidad para obtener soporte, compartir experiencias y estar al tanto de las últimas novedades.
              </p>

              <a
                href="https://discord.gg/ekr3ERWJQ6"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-10 py-7 text-lg font-semibold rounded-full bg-[#EAD08E] hover:bg-[#D4B870] text-[#2E0F12] transition-all duration-300 group/btn hover:shadow-lg hover:shadow-[#EAD08E]/30"
              >
                Unirse al Discord
                <svg class="h-5 w-5 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>
          </div>

          {/* Features Grid */}
          <div class="grid md:grid-cols-3 gap-6 animate-fade-in" style="animation-delay: 0.2s">
            {/* Comunidad Activa */}
            <div class="group">
              <div class="h-full bg-white border border-[#2E0F12]/10 rounded-2xl p-8 hover:border-[#EAD08E]/40 transition-all duration-500 hover:shadow-lg hover:shadow-[#EAD08E]/5 text-center">
                <div class="p-4 bg-[#EAD08E]/10 rounded-2xl w-fit mx-auto mb-6 group-hover:bg-[#EAD08E]/20 group-hover:scale-110 transition-all duration-300">
                  <svg class="h-7 w-7 text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                </div>
                <h3 class="font-display font-bold text-xl mb-3 text-[#2E0F12] group-hover:text-[#EAD08E] transition-colors">
                  Comunidad Activa
                </h3>
                <p class="text-[#4A2C2C]">
                  Comparte tips, tutoriales y experiencias con otros usuarios de Beekonz Trackers
                </p>
              </div>
            </div>

            {/* Soporte 24/7 */}
            <div class="group">
              <div class="h-full bg-white border border-[#2E0F12]/10 rounded-2xl p-8 hover:border-[#EAD08E]/40 transition-all duration-500 hover:shadow-lg hover:shadow-[#EAD08E]/5 text-center">
                <div class="p-4 bg-[#EAD08E]/10 rounded-2xl w-fit mx-auto mb-6 group-hover:bg-[#EAD08E]/20 group-hover:scale-110 transition-all duration-300">
                  <svg class="h-7 w-7 text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <h3 class="font-display font-bold text-xl mb-3 text-[#2E0F12] group-hover:text-[#EAD08E] transition-colors">
                  Soporte 24/7
                </h3>
                <p class="text-[#4A2C2C]">
                  Obtén ayuda rápida de nuestro equipo y de la comunidad en cualquier momento
                </p>
              </div>
            </div>

            {/* Novedades */}
            <div class="group">
              <div class="h-full bg-white border border-[#2E0F12]/10 rounded-2xl p-8 hover:border-[#EAD08E]/40 transition-all duration-500 hover:shadow-lg hover:shadow-[#EAD08E]/5 text-center">
                <div class="p-4 bg-[#EAD08E]/10 rounded-2xl w-fit mx-auto mb-6 group-hover:bg-[#EAD08E]/20 group-hover:scale-110 transition-all duration-300">
                  <svg class="h-7 w-7 text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
                </div>
                <h3 class="font-display font-bold text-xl mb-3 text-[#2E0F12] group-hover:text-[#EAD08E] transition-colors">
                  Novedades
                </h3>
                <p class="text-[#4A2C2C]">
                  Sé el primero en conocer nuevos productos, actualizaciones y ofertas especiales
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <Footer />
  </main>
</Base>