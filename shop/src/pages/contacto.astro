---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/store";
---

<Base title="Contacto | Beekonz" description="Contacta a Beekonz. Soporte 24/7 en Discord, email y más.">
  <Header />
  <main class="mx-auto max-w-4xl px-4 pt-32 pb-24 sm:px-6">
    <p class="text-center text-xs font-semibold tracking-widest text-bee-400 uppercase">Ayuda</p>
    <h1 class="font-display mt-3 text-center text-3xl font-bold sm:text-5xl">Contacto</h1>

    <div class="mt-12 space-y-8 text-neutral-300">
      <div class="rounded-2xl border border-white/10 bg-hive-900/50 p-8 text-center">
        <h2 class="font-display text-2xl font-bold text-white">¿Necesitas ayuda?</h2>
        <p class="mt-4">Nuestro equipo está disponible 24/7 para ayudarte con cualquier duda sobre tu pedido, garantía o soporte técnico.</p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <a href={SITE.discord} target="_blank" rel="noopener" class="rounded-2xl border border-white/10 bg-hive-900/50 p-6 text-center transition hover:border-bee-400">
          <p class="text-3xl">💬</p>
          <p class="mt-3 font-display font-semibold text-white">Discord</p>
          <p class="mt-2 text-sm text-neutral-400">Soporte 24/7 en español</p>
        </a>
        <a href="mailto:redes@beekonz.shop" class="rounded-2xl border border-white/10 bg-hive-900/50 p-6 text-center transition hover:border-bee-400">
          <p class="text-3xl">📧</p>
          <p class="mt-3 font-display font-semibold text-white">Email</p>
          <p class="mt-2 text-sm text-neutral-400">redes@beekonz.shop</p>
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Base>
