---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/store";
---

<Base title="Contacto | Beekonz">
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero-dark">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <span class="badge mb-6">Comunidad</span>
          <h1 class="text-display-xxl text-white mb-6">
            Únete a Nuestra <span class="text-gradient-gold">Comunidad</span>
          </h1>
          <p class="text-body-lg text-[#d4b8b9]">
            ¿Tienes preguntas? Únete a nuestro servidor de Discord para obtener soporte y conectar con otros usuarios.
          </p>
        </div>
      </div>
    </section>

    <!-- Main Discord Card -->
    <section class="section section-light">
      <div class="container">
        <div class="card text-center max-w-2xl mx-auto">
          <div class="w-24 h-24 bg-[#EAD08E]/20 rounded-2xl flex items-center justify-center mx-auto mb-8">
            <svg class="h-12 w-12 text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          </div>
          <h2 class="text-display-lg text-[#2E0F12] mb-4">Discord Beekonz</h2>
          <p class="text-body-lg text-[#8b6b6e] mb-8">
            Únete a nuestra comunidad para obtener soporte, compartir experiencias y estar al tanto de las últimas novedades.
          </p>
          <a href={SITE.discord} target="_blank" rel="noopener noreferrer" class="btn-primary text-lg">
            Unirse al Discord
          </a>
        </div>
      </div>
    </section>

    <!-- Features Grid -->
    <section class="section section-soft">
      <div class="container">
        <div class="grid md:grid-cols-3 gap-6">
          <div class="card text-center">
            <div class="p-4 bg-[#EAD08E]/10 rounded-xl w-fit mx-auto mb-6">
              <svg class="h-7 w-7 text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            </div>
            <h3 class="text-heading-lg text-[#2E0F12] mb-3">Comunidad Activa</h3>
            <p class="text-body-md text-[#8b6b6e]">Comparte tips, tutoriales y experiencias con otros usuarios de Beekonz Trackers</p>
          </div>

          <div class="card text-center">
            <div class="p-4 bg-[#EAD08E]/10 rounded-xl w-fit mx-auto mb-6">
              <svg class="h-7 w-7 text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="text-heading-lg text-[#2E0F12] mb-3">Soporte 24/7</h3>
            <p class="text-body-md text-[#8b6b6e]">Obtén ayuda rápida de nuestro equipo y de la comunidad en cualquier momento</p>
          </div>

          <div class="card text-center">
            <div class="p-4 bg-[#EAD08E]/10 rounded-xl w-fit mx-auto mb-6">
              <svg class="h-7 w-7 text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
            </div>
            <h3 class="text-heading-lg text-[#2E0F12] mb-3">Novedades</h3>
            <p class="text-body-md text-[#8b6b6e]">Sé el primero en conocer nuevos productos, actualizaciones y ofertas especiales</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
