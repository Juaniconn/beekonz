---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { FAQ } from "../data/store";
---

<Base title="Preguntas Frecuentes | Beekonz" description="Respuestas a las preguntas más comunes sobre Beekonz Trackers.">
  <Header />
  <main class="mx-auto max-w-4xl px-4 pt-32 pb-24 sm:px-6">
    <p class="text-center text-xs font-semibold tracking-widest text-bee-400 uppercase">Recursos</p>
    <h1 class="font-display mt-3 text-center text-3xl font-bold sm:text-5xl">Preguntas <span class="text-gradient-bee">Frecuentes</span></h1>

    <div class="mt-12 space-y-4">
      {FAQ.map((item, i) => (
        <details class="group rounded-xl border border-white/10 bg-hive-900/50">
          <summary class="flex cursor-pointer items-center justify-between p-6">
            <span class="font-display font-semibold text-white">{item.q}</span>
            <span class="text-bee-400 group-open:rotate-180 transition">▼</span>
          </summary>
          <div class="border-t border-white/5 px-6 py-4 text-neutral-300">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </main>
  <Footer />
</Base>
