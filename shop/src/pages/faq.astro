---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { FAQ } from "../data/store";
---

<Base title="Preguntas Frecuentes | Beekonz" description="Encuentra respuestas a las dudas más comunes sobre nuestros trackers Beekonz, envíos, compatibilidad y soporte.">
  <Header />

  <main>
    <!-- Hero -->
    <section class="bg-[#2E0F12] text-white pt-32 pb-20">
      <div class="container mx-auto px-4 text-center">
        <p class="text-[#EAD08E] text-button-cap uppercase tracking-widest mb-4">Centro de Ayuda</p>
        <h1 class="text-display-xxl font-display font-bold mb-6">
          Preguntas <span class="text-[#EAD08E]">Frecuentes</span>
        </h1>
        <p class="text-body-lg text-[#d4b8b9] max-w-2xl mx-auto">
          Encuentra respuestas a las dudas más comunes sobre nuestros trackers.
        </p>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <section class="section-soft">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <div class="space-y-4">
            {FAQ.map((item, index) => (
              <details class="group bg-white rounded-2xl border border-[#2E0F12]/10 hover:border-[#EAD08E]/40 transition-all duration-300 overflow-hidden">
                <summary class="flex items-center justify-between p-6 cursor-pointer text-left">
                  <span class="text-heading-lg text-[#2E0F12] group-hover:text-[#2E0F12] pr-4">{item.q}</span>
                  <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[#EAD08E]/10 flex items-center justify-center group-open:rotate-180 transition-transform">
                    <svg class="w-4 h-4 text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                  </span>
                </summary>
                <div class="px-6 pb-6 text-body-md text-[#8b6b6e] leading-relaxed">
                  {item.a}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="section-light">
      <div class="container mx-auto px-4">
        <div class="max-w-2xl mx-auto text-center">
          <div class="card">
            <h2 class="text-display-md font-display font-bold text-[#2E0F12] mb-4">
              ¿No encontraste lo que buscabas?
            </h2>
            <p class="text-body-lg text-[#8b6b6e] mb-6">
              Nuestro equipo de soporte está disponible 24/7 en Discord para ayudarte.
            </p>
            <a href="https://discord.gg/ekr3ERWJQ6" target="_blank" rel="noopener noreferrer" class="btn-primary text-button-md">
              Preguntar en Discord
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>