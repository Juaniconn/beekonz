---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { FAQ } from "../data/store";
---

<Base title="FAQ | Beekonz Trackers">
  <Header />

  <section class="pt-40 pb-20 bg-[#050505]">
    <div class="container max-w-3xl text-center">
      <p class="caption text-[#EAD08E] tracking-widest uppercase mb-4">FAQ</p>
      <h1 class="display-lg text-white mb-6">Preguntas Frecuentes</h1>
      <p class="body-lg text-[#a0a0a0]">Todo lo que necesitas saber sobre nuestros trackers. Si no encuentras tu respuesta, escríbenos en Discord.</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container max-w-3xl">
      <div class="space-y-4" id="faq-accordion">
        {FAQ.map((item, idx) => (
          <div class="rounded-xl border border-[#050505]/10 overflow-hidden">
            <button class="w-full px-6 py-5 flex items-center justify-between text-left hover:bg-[#f5f5f5] transition-colors" data-faq-toggle={idx}>
              <span class="heading-lg text-[#050505]">{item.q}</span>
              <svg class="w-5 h-5 text-[#8b6b6e] transition-transform duration-200 flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-faq-icon={idx}><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="hidden px-6 pb-5" data-faq-content={idx}>
              <p class="body-md text-[#555555]">{item.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-[#050505] text-center">
    <div class="container max-w-3xl">
      <h2 class="display-lg text-white mb-6">¿Tienes más preguntas?</h2>
      <p class="body-lg text-[#a0a0a0] mb-8">Nuestro equipo en Discord te responde en menos de 24 horas.</p>
      <a href="https://discord.gg/ekr3ERWJQ6" target="_blank" rel="noopener noreferrer" class="btn btn-gold text-base px-8 py-4">
        Preguntar en Discord
      </a>
    </div>
  </section>

  <Footer />
</Base>

<script>
  document.querySelectorAll('[data-faq-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.getAttribute('data-faq-toggle');
      const content = document.querySelector(`[data-faq-content="${idx}"]`);
      const icon = document.querySelector(`[data-faq-icon="${idx}"]`);
      const isHidden = content.classList.contains('hidden');
      
      document.querySelectorAll('[data-faq-content]').forEach((c) => c.classList.add('hidden'));
      document.querySelectorAll('[data-faq-icon]').forEach((i) => i.classList.remove('rotate-180'));
      
      if (isHidden) {
        content.classList.remove('hidden');
        icon?.classList.add('rotate-180');
      }
    });
  });
</script>
