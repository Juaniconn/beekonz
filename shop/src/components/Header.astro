---
import { SITE, PACKS } from "../data/store";

const PRODUCTOS = [
  { label: "Starter Pack (6 Trackers)", href: "/#packs" },
  { label: "Advanced Pack (8 Trackers)", href: "/#packs" },
  { label: "Pro Pack (10 Trackers)", href: "/#packs" },
  { label: "Face Tracking", href: "/#face-tracking" },
  { label: "Crear mi Set", href: "/acerca-de" },
];

const QUIENES_SOMOS = [
  { label: "Acerca de Beekonz", href: "/acerca-de" },
  { label: "Nuestra Misión", href: "/nuestra-mision" },
  { label: "Garantía y Devoluciones", href: "/garantia-reembolsos" },
  { label: "Política de Privacidad", href: "/privacidad" },
  { label: "Términos y Condiciones", href: "/terminos-condiciones" },
];

const RECURSOS = [
  { label: "FAQ", href: "/faq" },
  { label: "Seguimiento de Pedidos", href: "/seguimiento-pedidos" },
  { label: "Especificaciones Técnicas", href: "/especificaciones" },
];

const SOCIALES = [
  { name: "Discord", href: SITE.discord, icon: "discord" },
  { name: "TikTok", href: "https://tiktok.com/@beekonz", icon: "tiktok" },
  { name: "Instagram", href: "https://instagram.com/beekonz", icon: "instagram" },
  { name: "Facebook", href: "https://facebook.com/beekonz", icon: "facebook" },
];
---

<header class="fixed top-0 inset-x-0 z-50 bg-brand-950/80 backdrop-blur-xl border-b border-white/5">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="/" class="font-display text-xl font-bold tracking-tight flex items-center gap-2">
      <span class="text-2xl">🐝</span>
      <span class="text-white">BEEK</span><span class="text-gradient-gold">ONZ</span>
    </a>
    
    <div class="hidden lg:flex items-center gap-8">
      <a href="/#packs" class="text-sm text-brand-400 hover:text-accent transition">Packs</a>
      <a href="/#face-tracking" class="text-sm text-brand-400 hover:text-accent transition">Face Tracking</a>
      <a href="/#tecnologia" class="text-sm text-brand-400 hover:text-accent transition">Tecnología</a>
      <a href="/seguimiento-pedidos" class="text-sm text-brand-400 hover:text-accent transition">Seguimiento</a>
    </div>
    
    <div class="flex items-center gap-4">
      <a
        href={PACKS[1].stripe}
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-block px-6 py-2.5 bg-accent rounded-full text-sm font-bold text-brand-900 transition hover:scale-105 hover:shadow-[0_0_20px_rgba(234,208,142,0.4)]"
      >
        Comprar
      </a>
      <button id="menu-btn" class="lg:hidden p-2 text-brand-400 hover:text-accent" aria-label="Abrir menú">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>
  
  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden border-t border-white/5 bg-brand-950/95 px-6 py-6 lg:hidden">
    <div class="flex flex-col gap-4">
      <a href="/#packs" class="text-brand-300 hover:text-accent py-2">Packs</a>
      <a href="/#face-tracking" class="text-brand-300 hover:text-accent py-2">Face Tracking</a>
      <a href="/#tecnologia" class="text-brand-300 hover:text-accent py-2">Tecnología</a>
      <a href="/seguimiento-pedidos" class="text-brand-300 hover:text-accent py-2">Seguimiento</a>
      <a href={PACKS[1].stripe} class="mt-4 block rounded-full bg-accent py-3 text-center font-bold text-brand-900">Comprar Ahora</a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  menuBtn?.addEventListener("click", () => mobileMenu?.classList.toggle("hidden"));
</script>
