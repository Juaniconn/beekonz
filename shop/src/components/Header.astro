---
import { SITE, PACKS } from "../data/store";

const PRODUCTOS = [
  { name: "Starter Pack (6 Trackers)", href: "https://buy.stripe.com/eVq28sf2dbwhfIX3Rj7g40o", external: true },
  { name: "Advanced Pack (8 Trackers)", href: "https://buy.stripe.com/3cI9AUbQ10RDeETdrT7g40r", external: true },
  { name: "Pro Pack (10 Trackers)", href: "https://buy.stripe.com/28EfZi9HTcAlfIX73v7g40p", external: true },
  { name: "Face Tracking", href: "https://buy.stripe.com/9B628s7zL43PgN13Rj7g40u", external: true },
  { name: "Crear mi Set", href: "https://discord.gg/ekr3ERWJQ6", external: true },
];

const ABOUT = [
  { name: "Acerca de Beekonz", href: "/acerca-de" },
  { name: "Nuestra Misión", href: "/nuestra-mision" },
  { name: "Garantía y Devoluciones", href: "/garantia-reembolsos" },
  { name: "Política de Privacidad", href: "/privacidad" },
  { name: "Términos y Condiciones", href: "/terminos-condiciones" },
];

const RECURSOS = [
  { name: "FAQ", href: "/faq" },
  { name: "Seguimiento de Pedidos", href: "/seguimiento-pedidos" },
  { name: "Especificaciones Técnicas", href: "/especificaciones" },
];

const SOCIALES = [
  { name: "Discord", href: SITE.discord, icon: "discord" },
  { name: "TikTok", href: "https://tiktok.com/@beekonz", icon: "tiktok" },
  { name: "Instagram", href: "https://instagram.com/beekonz", icon: "instagram" },
  { name: "Facebook", href: "https://facebook.com/profile.php?id=100083643665008", icon: "facebook" },
];
---

<header class="fixed top-4 left-1/2 -translate-x-1/2 z-50 transition-all duration-500" id="main-header">
  <nav class="flex items-center gap-2 px-3 py-2 bg-[#2E0F12]/95 backdrop-blur-xl rounded-full border border-white/10 shadow-lg">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 px-3 py-2 rounded-full hover:bg-white/5 transition-all duration-300">
      <img src="/images/Beekonz_White_Logo.png" alt="Beekonz" class="h-6 w-auto" />
    </a>

    <!-- Menu Button - Desktop -->
    <button id="mega-menu-btn" class="hidden md:flex items-center gap-2 px-4 py-2 bg-[#2E0F12] rounded-full border border-white/10 hover:border-[#EAD08E]/50 transition-all duration-300 group">
      <div class="flex flex-col gap-1">
        <span class="block w-4 h-0.5 bg-white transition-all duration-300" id="line1"></span>
        <span class="block w-4 h-0.5 bg-white transition-all duration-300" id="line2"></span>
        <span class="block w-4 h-0.5 bg-white transition-all duration-300" id="line3"></span>
      </div>
      <span class="text-white text-sm font-medium">menu</span>
    </button>

    <!-- Social Icons -->
    <div class="hidden md:flex items-center gap-1">
      {SOCIALES.slice(0, 2).map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          class="w-9 h-9 flex items-center justify-center rounded-full bg-white/5 border border-white/10 hover:bg-[#EAD08E] hover:border-[#EAD08E] hover:text-[#2E0F12] transition-all duration-300"
          aria-label={social.name}
        >
          {social.icon === "discord" && (
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          )}
          {social.icon === "tiktok" && (
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
          )}
        </a>
      ))}
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden flex items-center justify-center w-9 h-9 rounded-full bg-[#2E0F12] border border-white/10">
      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </nav>

  <!-- Mega Menu - Desktop -->
  <div id="mega-menu" class="absolute top-full left-1/2 -translate-x-1/2 mt-4 transition-all duration-500 hidden md:block opacity-0 -translate-y-4 pointer-events-none">
    <div class="relative flex rounded-3xl overflow-hidden shadow-2xl border border-white/10 bg-[#2E0F12]/95 backdrop-blur-xl">
      <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-4 h-4 bg-[#2E0F12] rotate-45 rounded-sm border-l border-t border-white/10"></div>
      
      <!-- Productos -->
      <div class="w-64 p-6 relative overflow-hidden border-r border-white/10">
        <div class="absolute inset-0 bg-gradient-to-br from-[#EAD08E]/10 to-transparent pointer-events-none"></div>
        <div class="relative">
          <h3 class="text-[#EAD08E] text-sm font-medium uppercase tracking-wider mb-6">Productos</h3>
          <ul class="space-y-3">
            {PRODUCTOS.map((item, idx) => (
              <li key={idx}>
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  class="flex items-center justify-between text-[#F8F4F5]/70 hover:text-[#EAD08E] text-sm py-1 group transition-colors"
                >
                  <span>{item.name}</span>
                  <svg class="w-4 h-4 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Quiénes Somos -->
      <div class="w-56 p-6 relative overflow-hidden border-r border-white/10">
        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent pointer-events-none"></div>
        <div class="relative">
          <h3 class="text-[#F8F4F5] text-sm font-medium uppercase tracking-wider mb-6">Quiénes Somos</h3>
          <ul class="space-y-3">
            {ABOUT.map((item, idx) => (
              <li key={idx}>
                <a
                  href={item.href}
                  class="flex items-center gap-3 text-[#F8F4F5]/70 hover:text-[#F8F4F5] text-sm py-1 group transition-colors"
                >
                  <span>{item.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Recursos -->
      <div class="w-56 p-6 relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-bl from-[#EAD08E]/10 to-transparent pointer-events-none"></div>
        <div class="relative">
          <h3 class="text-[#EAD08E] text-sm font-medium uppercase tracking-wider mb-6">Recursos</h3>
          <ul class="space-y-3">
            {RECURSOS.map((item, idx) => (
              <li key={idx}>
                <a
                  href={item.href}
                  class="flex items-center gap-3 text-[#F8F4F5]/70 hover:text-[#F8F4F5] text-sm py-1 group transition-colors"
                >
                  <span>{item.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="fixed inset-0 z-40 bg-[#2E0F12]/98 backdrop-blur-xl pt-20 px-6 overflow-y-auto hidden md:hidden">
    <div class="flex flex-col space-y-6">
      <!-- Productos -->
      <div>
        <h3 class="text-[#EAD08E] text-sm font-medium uppercase tracking-wider mb-4">Productos</h3>
        <ul class="space-y-3 pl-2">
          {PRODUCTOS.map((item, idx) => (
            <li key={idx}>
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                class="text-[#F8F4F5]/70 hover:text-[#EAD08E] text-sm flex items-center gap-2"
              >
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quiénes Somos -->
      <div>
        <h3 class="text-[#F8F4F5] text-sm font-medium uppercase tracking-wider mb-4">Quiénes Somos</h3>
        <ul class="space-y-3 pl-2">
          {ABOUT.map((item, idx) => (
            <li key={idx}>
              <a href={item.href} class="text-[#F8F4F5]/70 hover:text-[#F8F4F5] text-sm flex items-center gap-3">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Recursos -->
      <div>
        <h3 class="text-[#EAD08E] text-sm font-medium uppercase tracking-wider mb-4">Recursos</h3>
        <ul class="space-y-3 pl-2">
          {RECURSOS.map((item, idx) => (
            <li key={idx}>
              <a href={item.href} class="text-[#F8F4F5]/70 hover:text-[#F8F4F5] text-sm flex items-center gap-3">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social Links -->
      <div class="pt-4 border-t border-white/10">
        <h3 class="text-[#F8F4F5]/50 text-sm font-medium uppercase tracking-wider mb-4">Síguenos</h3>
        <div class="flex items-center gap-3">
          {SOCIALES.map((social) => (
            <a
              key={social.name}
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center rounded-full bg-white/5 text-[#F8F4F5]/70 hover:bg-[#EAD08E] hover:text-[#2E0F12] transition-all duration-300"
            >
              {social.icon === "discord" && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
              )}
              {social.icon === "tiktok" && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
              )}
              {social.icon === "instagram" && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
              )}
              {social.icon === "facebook" && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const megaMenuBtn = document.getElementById("mega-menu-btn");
  const megaMenu = document.getElementById("mega-menu");
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const line1 = document.getElementById("line1");
  const line2 = document.getElementById("line2");
  const line3 = document.getElementById("line3");

  let isMegaMenuOpen = false;

  megaMenuBtn?.addEventListener("click", () => {
    isMegaMenuOpen = !isMegaMenuOpen;
    if (isMegaMenuOpen) {
      megaMenu.classList.remove("hidden");
      setTimeout(() => {
        megaMenu.classList.remove("opacity-0", "-translate-y-4", "pointer-events-none");
        megaMenu.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
      }, 10);
      line1?.classList.add("translate-y-1.5", "rotate-45");
      line2?.classList.add("opacity-0");
      line3?.classList.add("-translate-y-1.5", "-rotate-45");
    } else {
      megaMenu.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
      megaMenu.classList.add("opacity-0", "-translate-y-4", "pointer-events-none");
      setTimeout(() => megaMenu.classList.add("hidden"), 500);
      line1?.classList.remove("translate-y-1.5", "rotate-45");
      line2?.classList.remove("opacity-0");
      line3?.classList.remove("-translate-y-1.5", "-rotate-45");
    }
  });

  mobileMenuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });

  // Close mega menu when clicking outside
  document.addEventListener("click", (e) => {
    const target = e.target;
    if (!target?.closest("#mega-menu") && !target?.closest("#mega-menu-btn") && isMegaMenuOpen) {
      isMegaMenuOpen = false;
      megaMenu.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
      megaMenu.classList.add("opacity-0", "-translate-y-4", "pointer-events-none");
      setTimeout(() => megaMenu.classList.add("hidden"), 500);
      line1?.classList.remove("translate-y-1.5", "rotate-45");
      line2?.classList.remove("opacity-0");
      line3?.classList.remove("-translate-y-1.5", "-rotate-45");
    }
  });

  // Close mobile menu when clicking links
  mobileMenu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => mobileMenu.classList.add("hidden"));
  });
</script>
