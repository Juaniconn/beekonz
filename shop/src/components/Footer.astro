---
import { SITE, PACKS } from "../data/store";

const SOCIALS = [
  { name: "Discord", href: SITE.discord, icon: "discord" },
  { name: "TikTok", href: "https://tiktok.com/@beekonz", icon: "tiktok" },
  { name: "Instagram", href: "https://instagram.com/beekonz", icon: "instagram" },
  { name: "Facebook", href: "https://facebook.com/beekonz", icon: "facebook" },
];

const AYUDA = [
  { label: "Contacto", href: "/contacto" },
  { label: "Seguimiento de Pedidos", href: "/seguimiento-pedidos" },
  { label: "Discord", href: SITE.discord, external: true },
  { label: "Especificaciones", href: "/especificaciones" },
];

const POLITICAS = [
  { label: "Política de Privacidad", href: "/privacidad" },
  { label: "Política de Venta", href: "/politica-venta" },
  { label: "Política de Envíos", href: "/politica-envios" },
  { label: "Garantía y Reembolsos", href: "/garantia-reembolsos" },
  { label: "Términos y Condiciones", href: "/terminos-condiciones" },
];

const PRODUCTOS = [
  { label: "Starter Pack (6)", href: "/#packs" },
  { label: "Advanced Pack (8)", href: "/#packs" },
  { label: "Pro Pack (10)", href: "/#packs" },
];
---

<footer class="border-t border-white/5 bg-brand-950">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-4">
      <!-- Columna 1: Marca -->
      <div>
        <p class="font-display text-xl font-bold flex items-center gap-2">
          <span class="text-2xl">🐝</span>
          <span class="text-white">BEEK</span><span class="text-gradient-gold">ONZ</span>
        </p>
        <p class="mt-4 text-sm text-brand-400 leading-relaxed">
          Precisión que se siente. Libertad que se vive. Full Body Tracking de Alta Precisión para la comunidad hispana.
        </p>
        <div class="mt-6 flex gap-3">
          {SOCIALS.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              aria-label={s.name}
              class="flex h-10 w-10 items-center justify-center rounded-full border border-white/10 text-brand-400 transition hover:border-accent hover:text-accent"
            >
              {s.icon === "discord" && (
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
              )}
              {s.icon === "tiktok" && (
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
              )}
              {s.icon === "instagram" && (
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
              )}
              {s.icon === "facebook" && (
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Columna 2: Ayuda -->
      <div>
        <p class="font-display font-bold text-white mb-4">AYUDA</p>
        <ul class="space-y-3 text-sm text-brand-400">
          {AYUDA.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener" : undefined}
                class="hover:text-accent transition"
              >
                {link.label}
                {link.external && " ↗"}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Políticas -->
      <div>
        <p class="font-display font-bold text-white mb-4">POLÍTICAS</p>
        <ul class="space-y-3 text-sm text-brand-400">
          {POLITICAS.map((link) => (
            <li>
              <a href={link.href} class="hover:text-accent transition">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 4: Productos -->
      <div>
        <p class="font-display font-bold text-white mb-4">PRODUCTOS</p>
        <ul class="space-y-3 text-sm text-brand-400">
          {PRODUCTOS.map((link) => (
            <li>
              <a href={link.href} class="hover:text-accent transition">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-8 text-xs text-brand-500 sm:flex-row">
      <p>© {new Date().getFullYear()} Beekonz Trackers. Todos los derechos reservados.</p>
      <p>Hecho con 💛 para la comunidad VR hispana</p>
    </div>
  </div>
</footer>
