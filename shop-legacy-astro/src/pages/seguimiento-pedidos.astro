---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Seguimiento de Pedidos | Beekonz">
  <Header />

  <main>
    <section class="hero-dark">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <span class="badge mb-6">Seguimiento</span>
          <h1 class="text-display-xxl text-white mb-6">Seguimiento de <span class="text-gradient-gold">Pedidos</span></h1>
          <p class="text-body-lg text-[#a0a0a0]">Consulta el estado de tu pedido en tiempo real.</p>
        </div>
      </div>
    </section>

    <section class="section section-light">
      <div class="container max-w-4xl">
        <div class="card">
          <div class="aspect-video w-full">
            <iframe 
              src="https://app.clickup.com/embed?v=8cr2nra-517" 
              class="w-full h-full rounded-lg"
              style="min-height: 600px;"
              frameborder="0"
              allowfullscreen>
            </iframe>
          </div>
        </div>

        <div class="mt-8 card">
          <h2 class="text-heading-lg text-white mb-4">¿Cómo funciona?</h2>
          <ul class="space-y-3 text-body-md text-[#a0a0a0]">
            <li class="flex items-start gap-3">
              <span class="text-[#EAD08E]">1.</span>
              <span>Realiza tu compra y recibe el correo de confirmación.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-[#EAD08E]">2.</span>
              <span>Tu pedido pasa por nuestro proceso de fabricación y pruebas.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-[#EAD08E]">3.</span>
              <span>Una vez enviado, recibirás el número de seguimiento por correo.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-[#EAD08E]">4.</span>
              <span>Consulta el estado actualizado en el panel de arriba.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
