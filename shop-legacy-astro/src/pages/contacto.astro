---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/store";
---

<Base title="Contacto | Beekonz Trackers">
  <Header />

  <section class="pt-40 pb-20 bg-[#050505]">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-16">
        <!-- Left — Info -->
        <div class="space-y-8">
          <div>
            <p class="caption text-[#EAD08E] tracking-widest uppercase mb-4">Contacto</p>
            <h1 class="display-lg text-white mb-6">Hablemos</h1>
            <p class="body-lg text-[#a0a0a0]">
              ¿Preguntas sobre trackers? ¿Necesitas ayuda con tu setup? ¿Quieres crear un set personalizado? Estamos aquí para ayudarte.
            </p>
          </div>

          <div class="space-y-6 pt-8 border-t border-white/10">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-[#EAD08E]/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              </div>
              <div>
                <p class="heading-lg text-white mb-1">Discord</p>
                <p class="body-sm text-[#666666]">Nuestro canal principal. Soporte 24/7 en español.</p>
                <a href={SITE.discord} target="_blank" rel="noopener noreferrer" class="body-sm text-[#EAD08E] hover:underline mt-2 inline-block">
                  Unirse al servidor →
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-[#EAD08E]/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="heading-lg text-white mb-1">Email</p>
                <p class="body-sm text-[#666666]">Para colaboraciones y ventas mayoristas.</p>
                <p class="body-sm text-[#EAD08E] mt-2">redes@beekonz.shop</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-[#EAD08E]/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-[#EAD08E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <p class="heading-lg text-white mb-1">Horario</p>
                <p class="body-sm text-[#666666]">Respuesta en menos de 24 horas.</p>
                <p class="body-sm text-[#EAD08E] mt-2">Lun - Dom (GMT-6)</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right — Form -->
        <div class="rounded-xl border border-white/10 bg-[#111111] p-8">
          <form class="space-y-6" name="contacto" method="POST" data-netlify="true">
            <input type="hidden" name="form-name" value="contacto" />
            
            <div>
              <label class="caption text-[#666666] block mb-2">Nombre</label>
              <input type="text" name="nombre" required class="w-full bg-[#0a0a0a] border border-white/10 rounded-lg px-4 py-3 body-md text-white placeholder-[#666666] focus:outline-none focus:border-[#EAD08E] transition-colors" placeholder="Tu nombre" />
            </div>

            <div>
              <label class="caption text-[#666666] block mb-2">Email</label>
              <input type="email" name="email" required class="w-full bg-[#0a0a0a] border border-white/10 rounded-lg px-4 py-3 body-md text-white placeholder-[#666666] focus:outline-none focus:border-[#EAD08E] transition-colors" placeholder="tu@email.com" />
            </div>

            <div>
              <label class="caption text-[#666666] block mb-2">Asunto</label>
              <select name="asunto" class="w-full bg-[#0a0a0a] border border-white/10 rounded-lg px-4 py-3 body-md text-white focus:outline-none focus:border-[#EAD08E] transition-colors">
                <option value="">Selecciona un tema...</option>
                <option value="info">Información general</option>
                <option value="trackers">Pregunta sobre trackers</option>
                <option value="face">Face Tracking</option>
                <option value="custom">Set personalizado</option>
                <option value="soporte">Soporte técnico</option>
                <option value="mayoreo">Ventas mayoristas</option>
              </select>
            </div>

            <div>
              <label class="caption text-[#666666] block mb-2">Mensaje</label>
              <textarea name="mensaje" rows="4" required class="w-full bg-[#0a0a0a] border border-white/10 rounded-lg px-4 py-3 body-md text-white placeholder-[#666666] focus:outline-none focus:border-[#EAD08E] transition-colors resize-none" placeholder="¿En qué podemos ayudarte?"></textarea>
            </div>

            <button type="submit" class="btn btn-gold w-full text-base py-4">
              Enviar Mensaje
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>
