---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Especificaciones Técnicas | Beekonz">
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero-dark">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <span class="badge mb-6">Recursos</span>
          <h1 class="text-display-xxl text-white mb-6">Especificaciones <span class="text-gradient-gold">Técnicas</span></h1>
        </div>
      </div>
    </section>

    <!-- Tracker Specs -->
    <section class="section section-light">
      <div class="container">
        <h2 class="text-display-lg text-white mb-8">Beekonz Smols LSM6DSV</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="card">
            <p class="text-[#666666] text-micro uppercase mb-2">Sensor</p>
            <p class="text-white text-body-lg font-semibold">LSM6DSV (IMU 6-axis)</p>
          </div>
          <div class="card">
            <p class="text-[#666666] text-micro uppercase mb-2">Peso</p>
            <p class="text-white text-body-lg font-semibold">~10 g</p>
          </div>
          <div class="card">
            <p class="text-[#666666] text-micro uppercase mb-2">Batería</p>
            <p class="text-white text-body-lg font-semibold">401230, 3.7V, 115 mAh</p>
          </div>
          <div class="card">
            <p class="text-[#666666] text-micro uppercase mb-2">Autonomía</p>
            <p class="text-white text-body-lg font-semibold">35–45 h</p>
          </div>
          <div class="card">
            <p class="text-[#666666] text-micro uppercase mb-2">Latencia</p>
            <p class="text-white text-body-lg font-semibold">25–35 ms</p>
          </div>
          <div class="card">
            <p class="text-[#666666] text-micro uppercase mb-2">Conectividad</p>
            <p class="text-white text-body-lg font-semibold">nRF52840 USB Dongle</p>
          </div>
          <div class="card">
            <p class="text-[#666666] text-micro uppercase mb-2">Firmware</p>
            <p class="text-white text-body-lg font-semibold">Basado en SlimeVR</p>
          </div>
          <div class="card">
            <p class="text-[#666666] text-micro uppercase mb-2">Compatibilidad</p>
            <p class="text-white text-body-lg font-semibold">VRChat, SteamVR, NeosVR, ChilloutVR</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Face Tracking Specs -->
    <section class="section section-soft">
      <div class="container">
        <h2 class="text-display-lg text-white mb-8">Beekonz Face Tracking</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="card">
            <p class="text-[#666666] text-micro uppercase mb-2">Tipo</p>
            <p class="text-white text-body-lg font-semibold">Tracking facial USB-C</p>
          </div>
          <div class="card">
            <p class="text-[#666666] text-micro uppercase mb-2">Software</p>
            <p class="text-white text-body-lg font-semibold">Babble</p>
          </div>
          <div class="card">
            <p class="text-[#666666] text-micro uppercase mb-2">Conexión</p>
            <p class="text-white text-body-lg font-semibold">USB-C a PC</p>
          </div>
          <div class="card">
            <p class="text-[#666666] text-micro uppercase mb-2">Compatibilidad</p>
            <p class="text-white text-body-lg font-semibold">VRChat</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Dongle -->
    <section class="section section-light">
      <div class="container">
        <div class="card">
          <h2 class="text-heading-lg text-white mb-4">Dongle nRF52840</h2>
          <p class="text-body-md text-[#a0a0a0]">Cada pack incluye un dongle Holyiot nRF52840 optimizado para bajo consumo y máxima estabilidad. Cada tracker se conecta por un canal dedicado, eliminando interferencias.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
