---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, FAQ } from "../data/store";
---

<Base title="Preguntas Frecuentes | Beekonz">
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero-dark">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <span class="badge mb-6">FAQ</span>
          <h1 class="text-display-xxl text-white mb-6">¿Tienes Dudas?</h1>
          <p class="text-body-lg text-[#a0a0a0]">Respuestas a las preguntas más frecuentes sobre Beekonz Trackers.</p>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <section class="section section-light">
      <div class="container max-w-3xl">
        <div class="space-y-4">
          {FAQ.map((f) => (
            <details class="group rounded-xl border border-white/10 bg-[#0a0a0a] transition-all duration-300 hover:border-[#EAD08E]">
              <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 font-medium text-white text-body-lg [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-[#EAD08E] text-2xl transition group-open:rotate-45">+</span>
              </summary>
              <p class="px-6 pb-6 text-body-md text-[#a0a0a0]">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-band">
      <div class="container max-w-3xl text-center">
        <h2 class="text-display-xl text-white mb-6">¿Más preguntas?</h2>
        <p class="text-body-lg text-[#a0a0a0] mb-8">Únete a nuestro Discord y resuelve todas tus dudas directamente con la comunidad.</p>
        <a href={SITE.discord} target="_blank" rel="noopener" class="btn-primary text-lg">
          Preguntar en Discord
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
